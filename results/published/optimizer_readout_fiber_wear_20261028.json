  "proof_source_snapshot": "module\npublic import Mathlib.Basic.Real.Basic\npublic import Mathlib.Data.Fintype.Defs\npublic import Mathlib.Algebra.Order.BigOperators.Group.Finset\npublic import Mathlib.Algebra.BigOperators.Ring.Finset\npublic import Mathlib.Algebra.BigOperators.Fin\nimport Mathlib.Tactic.NormNum\nimport Mathlib.Tactic.Ring\nimport Mathlib.Tactic.FinCases\npublic section\nopen scoped BigOperators\nnamespace CGB.OptimizerContentReview\nnoncomputable def kernelSurvival {X : Type*} [Fintype X]\n    (K : \u2115 \u2192 X \u2192 X \u2192 \u211d) : \u2115 \u2192 \u2115 \u2192 X \u2192 \u211d\n  | 0, _, _ => 1\n  | n + 1, start, x => \u2211 y, K start x y * kernelSurvival K n (start + 1) y\n\n/-- One finite weighted-row certificate controls EVERY funded horizon.\nNo tick-by-tick expansion, stationarity, eigensolver or fitted retention rule\nis needed. The verifier supplies the same actual event kernel and checks the\nfinite row inequalities, including controlled rate intervals when present. -/\ntheorem kinetic_survival_envelope {X : Type*} [Fintype X]\n    (K : \u2115 \u2192 X \u2192 X \u2192 \u211d) (v : X \u2192 \u211d) (rho : \u211d)\n    (hK : \u2200 n x y, 0 \u2264 K n x y) (hr : 0 \u2264 rho) :\n    ((\u2200 x, v x \u2264 1) \u2192 (\u2200 n x, rho * v x \u2264 \u2211 y, K n x y * v y) \u2192\n      \u2200 T start x, rho ^ T * v x \u2264 kernelSurvival K T start x) \u2227\n    ((\u2200 x, 1 \u2264 v x) \u2192 (\u2200 n x, (\u2211 y, K n x y * v y) \u2264 rho * v x) \u2192\n      \u2200 T start x, kernelSurvival K T start x \u2264 rho ^ T * v x) := by\n  constructor\n  \u00b7 intro hv hrow T\n    induction T with\n    | zero => intro start x; simpa [kernelSurvival] using hv x\n    | succ n ih =>\n      intro start x\n      calc\n        rho ^ (n + 1) * v x = rho ^ n * (rho * v x) := by ring\n        _ \u2264 rho ^ n * \u2211 y, K start x y * v y :=\n          mul_le_mul_of_nonneg_left (hrow start x) (pow_nonneg hr _)\n        _ = \u2211 y, K start x y * (rho ^ n * v y) := by\n          rw [Finset.mul_sum]\n          apply Finset.sum_congr rfl\n          intro y _\n          ring\n        _ \u2264 \u2211 y, K start x y * kernelSurvival K n (start + 1) y := by\n          apply Finset.sum_le_sum\n          intro y _\n          exact mul_le_mul_of_nonneg_left (ih (start + 1) y) (hK start x y)\n        _ = kernelSurvival K (n + 1) start x := rfl\n  \u00b7 intro hv hrow T\n    induction T with\n    | zero => intro start x; simpa [kernelSurvival] using hv x\n    | succ n ih =>\n      intro start x\n      calc\n        kernelSurvival K (n + 1) start x =\n            \u2211 y, K start x y * kernelSurvival K n (start + 1) y := rfl\n        _ \u2264 \u2211 y, K start x y * (rho ^ n * v y) := by\n          apply Finset.sum_le_sum\n          intro y _\n          exact mul_le_mul_of_nonneg_left (ih (start + 1) y) (hK start x y)\n        _ = rho ^ n * \u2211 y, K start x y * v y := by\n          rw [Finset.mul_sum]\n          apply Finset.sum_congr rfl\n          intro y _\n          ring\n        _ \u2264 rho ^ n * (rho * v x) :=\n          mul_le_mul_of_nonneg_left (hrow start x) (pow_nonneg hr _)\n        _ = rho ^ (n + 1) * v x := by ring\n\n\nnamespace FiberWear\nset_option maxHeartbeats 4000000\nprivate def row0 (y : Fin 16) : \u2115 :=\n  match y.val with\n  | 0 => 15188748324890693572481478348\n  | 1 => 232000420570419930171648000\n  | 2 => 3625006571412811408932000\n  | 3 => 522000946283444842631528448\n  | 4 => 232000420570419930171648000\n  | 8 => 3625006571412811408932000\n  | 12 => 522000946283444842631528448\n  | _ => 0\nprivate def row1 (y : Fin 16) : \u2115 :=\n  match y.val with\n  | 0 => 232000420570419930171648000\n  | 1 => 15188748324890693572481478348\n  | 2 => 3625006571412811408932000\n  | 3 => 522000946283444842631528448\n  | 5 => 232000420570419930171648000\n  | 9 => 3625006571412811408932000\n  | 13 => 522000946283444842631528448\n  | _ => 0\nprivate def row2 (y : Fin 16) : \u2115 :=\n  match y.val with\n  | 0 => 232000420570419930171648000\n  | 1 => 232000420570419930171648000\n  | 2 => 14960372910920171879416677228\n  | 3 => 522000946283444842631528448\n  | 6 => 232000420570419930171648000\n  | 10 => 3625006571412811408932000\n  | 14 => 522000946283444842631528448\n  | _ => 0\nprivate def row3 (y : Fin 16) : \u2115 :=\n  match y.val with\n  | 0 => 1274446276341925974844126\n  | 1 => 1274446276341925974844126\n  | 2 => 1218663322265347461647662\n  | 3 => 15946516804927098630800435910\n  | 4 => 18889465931478580864000\n  | 5 => 18889465931478580864000\n  | 6 => 18889465931478580864000\n  | 7 => 232000420570419930171648000\n  | 8 => 295147905179352826000\n  | 9 => 295147905179352826000\n  | 10 => 295147905179352826000\n  | 11 => 3625006571412811408932000\n  | 12 => 42501298345826806923264\n  | 13 => 42501298345826806923264\n  | 14 => 42501298345826806923264\n  | 15 => 522000946283444842631528448\n  | _ => 0\nprivate def row4 (y : Fin 16) : \u2115 :=\n  match y.val with\n  | 0 => 232000420570419930171648000\n  | 4 => 15188748324890693572481478348\n  | 5 => 232000420570419930171648000\n  | 6 => 3625006571412811408932000\n  | 7 => 522000946283444842631528448\n  | 8 => 3625006571412811408932000\n  | 12 => 522000946283444842631528448\n  | _ => 0\nprivate def row5 (y : Fin 16) : \u2115 :=\n  match y.val with\n  | 1 => 232000420570419930171648000\n  | 4 => 232000420570419930171648000\n  | 5 => 15188748324890693572481478348\n  | 6 => 3625006571412811408932000\n  | 7 => 522000946283444842631528448\n  | 9 => 3625006571412811408932000\n  | 13 => 522000946283444842631528448\n  | _ => 0\nprivate def row6 (y : Fin 16) : \u2115 :=\n  match y.val with\n  | 2 => 232000420570419930171648000\n  | 4 => 232000420570419930171648000\n  | 5 => 232000420570419930171648000\n  | 6 => 14960372910920171879416677228\n  | 7 => 522000946283444842631528448\n  | 10 => 3625006571412811408932000\n  | 14 => 522000946283444842631528448\n  | _ => 0\nprivate def row7 (y : Fin 16) : \u2115 :=\n  match y.v