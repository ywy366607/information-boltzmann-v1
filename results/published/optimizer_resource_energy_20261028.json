    "proof_source_snapshot": "module\npublic import Mathlib.Basic.Real.Basic\npublic import Mathlib.Data.Fintype.Defs\npublic import Mathlib.Algebra.Order.BigOperators.Group.Finset\npublic import Mathlib.Algebra.BigOperators.Ring.Finset\npublic import Mathlib.Algebra.BigOperators.Fin\nimport Mathlib.Tactic.NormNum\nimport Mathlib.Tactic.Ring\nimport Mathlib.Tactic.FinCases\npublic section\nopen scoped BigOperators\nnamespace CGB.OptimizerContentReview\nnoncomputable def kernelSurvival {X : Type*} [Fintype X]\n    (K : ℕ → X → X → ℝ) : ℕ → ℕ → X → ℝ\n  | 0, _, _ => 1\n  | n + 1, start, x => ∑ y, K start x y * kernelSurvival K n (start + 1) y\n\n/-- One finite weighted-row certificate controls EVERY funded horizon.\nNo tick-by-tick expansion, stationarity, eigensolver or fitted retention rule\nis needed. The verifier supplies the same actual event kernel and checks the\nfinite row inequalities, including controlled rate intervals when present. -/\ntheorem kinetic_survival_envelope {X : Type*} [Fintype X]\n    (K : ℕ → X → X → ℝ) (v : X → ℝ) (rho : ℝ)\n    (hK : ∀ n x y, 0 ≤ K n x y) (hr : 0 ≤ rho) :\n    ((∀ x, v x ≤ 1) → (∀ n x, rho * v x ≤ ∑ y, K n x y * v y) →\n      ∀ T start x, rho ^ T * v x ≤ kernelSurvival K T start x) ∧\n    ((∀ x, 1 ≤ v x) → (∀ n x, (∑ y, K n x y * v y) ≤ rho * v x) →\n      ∀ T start x, kernelSurvival K T start x ≤ rho ^ T * v x) := by\n  constructor\n  · intro hv hrow T\n    induction T with\n    | zero => intro start x; simpa [kernelSurvival] using hv x\n    | succ n ih =>\n      intro start x\n      calc\n        rho ^ (n + 1) * v x = rho ^ n * (rho * v x) := by ring\n        _ ≤ rho ^ n * ∑ y, K start x y * v y :=\n          mul_le_mul_of_nonneg_left (hrow start x) (pow_nonneg hr _)\n        _ = ∑ y, K start x y * (rho ^ n * v y) := by\n          rw [Finset.mul_sum]\n          apply Finset.sum_congr rfl\n          intro y _\n          ring\n        _ ≤ ∑ y, K start x y * kernelSurvival K n (start + 1) y := by\n          apply Finset.sum_le_sum\n          intro y _\n          exact mul_le_mul_of_nonneg_left (ih (start + 1) y) (hK start x y)\n        _ = kernelSurvival K (n + 1) start x := rfl\n  · intro hv hrow T\n    induction T with\n    | zero => intro start x; simpa [kernelSurvival] using hv x\n    | succ n ih =>\n      intro start x\n      calc\n        kernelSurvival K (n + 1) start x =\n            ∑ y, K start x y * kernelSurvival K n (start + 1) y := rfl\n        _ ≤ ∑ y, K start x y * (rho ^ n * v y) := by\n          apply Finset.sum_le_sum\n          intro y _\n          exact mul_le_mul_of_nonneg_left (ih (start + 1) y) (hK start x y)\n        _ = rho ^ n * ∑ y, K start x y * v y := by\n          rw [Finset.mul_sum]\n          apply Finset.sum_congr rfl\n          intro y _\n          ring\n        _ ≤ rho ^ n * (rho * v x) :=\n          mul_le_mul_of_nonneg_left (hrow start x) (pow_nonneg hr _)\n        _ = rho ^ (n + 1) * v x := by ring\n\n\nnamespace ResourceWear\nset_option maxHeartbeats 4000000\nprivate def row0 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 0 => 18488466155892484305020910953275404\n  | 1 => 486540146000097297161953399013376\n  | 4 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row1 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 0 => 486540146000097297161953399013376\n  | 1 => 17994353516138418160236040739069964\n  | 2 => 7602189781251520268155521859584\n  | 3 => 486540146000097297161953399013376\n  | 5 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row2 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 1 => 486540146000097297161953399013376\n  | 2 => 18488466155892480847945246993010694\n  | 6 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row3 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 0 => 1544944333324587331231303073790\n  | 1 => 1544327781154422248032104873982\n  | 2 => 1505949222087097571097003950079\n  | 3 => 18975075612027675205072870990376978\n  | 4 => 39614081257132168796771975168\n  | 5 => 39614081257132168796771975168\n  | 6 => 39614081257132168796771975168\n  | 7 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row4 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 0 => 486540146000097297161953399013376\n  | 4 => 17994353516138418160236040739069964\n  | 5 => 486540146000097297161953399013376\n  | 8 => 7602189781251520268155521859584\n  | 12 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row5 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 1 => 486540146000097297161953399013376\n  | 4 => 486540146000097297161953399013376\n  | 5 => 17500240876384352015451170524864524\n  | 6 => 7602189781251520268155521859584\n  | 7 => 486540146000097297161953399013376\n  | 9 => 7602189781251520268155521859584\n  | 13 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row6 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 2 => 486540146000097297161953399013376\n  | 5 => 486540146000097297161953399013376\n  | 6 => 17994353516138414703160376778805254\n  | 10 => 7602189781251520268155521859584\n  | 14 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row7 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 0 => 39614081257132168796771975168\n  | 1 => 39614081257132168796771975168\n  | 2 => 39614081257132168796771975168\n  | 3 => 486540146000097297161953399013376\n  | 4 => 1504713699897289973733756239870\n  | 5 => 1504097147727124890534558040062\n  | 6 => 1465718588659800213599457116159\n  | 7 => 18480962972273609060288000776171538\n  | 8 => 618970019642690137449562112\n  | 9 => 618970019642690137449562112\n  | 10 => 618970019642690137449562112\n  | 11 => 7602189781251520268155521859584\n  | 12 => 39614081257132168796771975168\n  | 13 => 39614081257132168796771975168\n  | 14 => 39614081257132168796771975168\n  | 15 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row8 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 4 => 486540146000097297161953399013376\n  | 8 => 18488466155892480847945246993010694\n  | 9 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row9 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 5 => 486540146000097297161953399013376\n  | 8 => 486540146000097297161953399013376\n  | 9 => 17994353516138414703160376778805254\n  | 10 => 7602189781251520268155521859584\n  | 11 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row10 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 6 => 486540146000097297161953399013376\n  | 9 => 486540146000097297161953399013376\n  | 10 => 18488466155892477390869583032745984\n  | _ => 0\nprivate def row11 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 4 => 39614081257132168796771975168\n  | 5 => 39614081257132168796771975168\n  | 6 => 39614081257132168796771975168\n  | 7 => 486540146000097297161953399013376\n  | 8 => 1544944333324587049756326363135\n  | 9 => 1544327781154421966557128163327\n  | 10 => 1505949222087097289622027239424\n  | 11 => 18975075612027671747997207030112268\n  | _ => 0\nprivate def row12 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 0 => 1544944333324587331231303073790\n  | 1 => 39614081257132168796771975168\n  | 4 => 1544327781154422248032104873982\n  | 5 => 39614081257132168796771975168\n  | 8 => 1505949222087097571097003950079\n  | 9 => 39614081257132168796771975168\n  | 12 => 18975075612027675205072870990376978\n  | 13 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row13 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 0 => 39614081257132168796771975168\n  | 1 => 1504713699897289973733756239870\n  | 2 => 618970019642690137449562112\n  | 3 => 39614081257132168796771975168\n  | 4 => 39614081257132168796771975168\n  | 5 => 1504097147727124890534558040062\n  | 6 => 618970019642690137449562112\n  | 7 => 39614081257132168796771975168\n  | 8 => 39614081257132168796771975168\n  | 9 => 1465718588659800213599457116159\n  | 10 => 618970019642690137449562112\n  | 11 => 39614081257132168796771975168\n  | 12 => 486540146000097297161953399013376\n  | 13 => 18480962972273609060288000776171538\n  | 14 => 7602189781251520268155521859584\n  | 15 => 486540146000097297161953399013376\n  | _ => 0\nprivate def row14 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 1 => 39614081257132168796771975168\n  | 2 => 1544944333324587049756326363135\n  | 5 => 39614081257132168796771975168\n  | 6 => 1544327781154421966557128163327\n  | 9 => 39614081257132168796771975168\n  | 10 => 1505949222087097289622027239424\n  | 13 => 486540146000097297161953399013376\n  | 14 => 18975075612027671747997207030112268\n  | _ => 0\nprivate def row15 (y : Fin 16) : ℕ :=\n  match y.val with\n  | 1 => 8589934592\n  | 3 => 1584560832433359010752811237373\n  | 4 => 8589934592\n  | 5 => 17179869184\n  | 6 => 8589934592\n  | 7 => 1583944280263193927553613037565\n  | 9 => 8589934592\n  | 11 => 1545565721195869250618512113662\n  | 12 => 1584560832433359010752811237373\n  | 13 => 1583944280263193927553613037565\n  | 14 => 1545565721195869250618512113662\n  | 15 => 19461685068166406150604726351118360\n  | _ => 0\nprivate def raw (x y : Fin 16) : ℕ :=\n  match x.val with\n  | 0 => row0 y\n  | 1 => row1 y\n  | 2 => row2 y\n  | 3 => row3 y\n  | 4 => row4 y\n  | 5 => row5 y\n  | 6 => row6 y\n  | 7 => row7 y\n  | 8 => row8 y\n  | 9 => row9 y\n  | 10 => row10 y\n  | 11 => row11 y\n  | 12 => row12 y\n  | 13 => row13 y\n  | 14 => row14 y\n  | 15 => row15 y\n  | _ => 0\nprivate def rawValue (x : Fin 16) : ℕ :=\n  match x.val with\n  | 0 => 4057017954\n  | 1 => 4095865270\n  | 2 => 4057017954\n  | 3 => 4174311501\n  | 4 => 4095865270\n  | 5 => 4135081837\n  | 6 => 4095865270\n  | 7 => 4214273573\n  | 8 => 4057017954\n  | 9 => 4095865270\n  | 10 => 4057017954\n  | 11 => 4174311501\n  | 12 => 4174311501\n  | 13 => 4214273573\n  | 14 => 4174311501\n  | 15 => 4294967296\n  | _ => 0\n\nnoncomputable def kernel (_ : ℕ) (x y : Fin 16) : ℝ := raw x y / 19471113219505603606989361234575360\nnoncomputable def value (x : Fin 16) : ℝ := rawValue x / 4294967296\nnoncomputable def rho : ℝ := (18446507984574555810 : ℝ) / 18446744073709551616\ntheorem certificate : ∀ T start x,\n    rho^T * value x ≤ kernelSurvival kernel T start x := by\n  apply (kinetic_survival_envelope kernel value rho ?_ ?_).1\n  · intro x; fin_cases x <;> norm_num [value, rawValue]\n  · intro n x\n    fin_cases x <;> norm_num [kernel, raw, value, rawValue, rho,\n      row0, row1, row2, row3, row4, row5, row6, row7, row8, row9, row10, row11, row12, row13, row14, row15, Fin.sum_univ_succ]\n\n  · intro n x y\n    exact div_nonneg (Nat.cast_nonneg _) (by norm_num)\n  · norm_num [rho]\nend ResourceWear\n#print axioms kinetic_survival_envelope\n#print axioms ResourceWear.certificate\nend CGB.OptimizerContentReview\n",
