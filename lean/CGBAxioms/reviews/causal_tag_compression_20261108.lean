import CGBAxioms.LanguageLifeKernel
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.Analysis.Normed.Operator.Basic
import Mathlib.Analysis.InnerProductSpace.Basic
import Mathlib.Data.Finset.Lattice.Fold

/-!
# What a finite causal tag may merge

The silent subspace is relative to a REGISTERED family of future linearized
body/record transitions and arrived-outcome readouts. It is not given by low
activity, old age, or a learned encoder's dimension. Its quotient is an exact
algebraic target, not an algorithm that enumerates all future continuations.

The constructive factorization below keeps BOTH a shared effect basis U and
the ownership coefficients V. It is not a new body/output path. Exact bounded
rank requires a span condition; truncated factors require a read-error bound.
No assertion that the actual GDN admits a small exact rank is made here.

The finite insertion section supplies a concrete fixed-K candidate: one
projection sweep, merged ownership, minimum-bound discard among K+1 choices,
and a propagated radius. The full participation map is only a proof reference.
The admitted joint gain and numerical branch/roundoff bounds still require
actual-runtime instantiation; no network is run or modified by these proofs.
-/

namespace CGB.CausalTagCompression

section Observable

variable {E U O Q : Type*} [AddCommGroup E] [Module ℝ E]
    [AddCommGroup Q] [Module ℝ Q]

/-- Conditional future propagation of one participation direction. -/
def futureMap (A : U → E →ₗ[ℝ] E) : List U → E →ₗ[ℝ] E
  | [] => LinearMap.id
  | u :: rest => (futureMap A rest).comp (A u)

/-- Every future modulation/observation test that this credit contract
allows. Enlarging this family can only shrink the discardable directions. -/
def silent (A : U → E →ₗ[ℝ] E) (m : O → E →ₗ[ℝ] ℝ) : Submodule ℝ E :=
  ⨅ (w : List U) (o : O), LinearMap.ker ((m o).comp (futureMap A w))

theorem mem_silent_iff (A : U → E →ₗ[ℝ] E) (m : O → E →ₗ[ℝ] ℝ) (x : E) :
    x ∈ silent A m ↔ ∀ w o, m o (futureMap A w x) = 0 := by
  simp [silent, LinearMap.mem_ker]

/-- Invisible now is insufficient: a discardable direction must remain
invisible after every allowed continuation. -/
theorem silent_is_invariant (A : U → E →ₗ[ℝ] E) (m : O → E →ₗ[ℝ] ℝ)
    (u : U) (x : E) (hx : x ∈ silent A m) : A u x ∈ silent A m := by
  rw [mem_silent_iff] at hx ⊢
  intro w o
  exact hx (u :: w) o

theorem silent_reads_zero (A : U → E →ₗ[ℝ] E) (m : O → E →ₗ[ℝ] ℝ)
    (x : E) (hx : x ∈ silent A m) (o : O) : m o x = 0 := by
  simpa [futureMap] using (mem_silent_iff A m x).mp hx [] o

theorem invariant_future (A : U → E →ₗ[ℝ] E) (N : Submodule ℝ E)
    (hN : ∀ u x, x ∈ N → A u x ∈ N) (w : List U) (x : E) (hx : x ∈ N) :
    futureMap A w x ∈ N := by
  induction w generalizing x with
  | nil => exact hx
  | cons u rest ih => exact ih (A u x) (hN u x hx)

/-- The maximal EXACT discardable linear subspace is generated by future
invisibility and transition invariance, rather than a hand-written module list. -/
theorem silent_is_largest (A : U → E →ₗ[ℝ] E) (m : O → E →ₗ[ℝ] ℝ)
    (N : Submodule ℝ E) (hN : ∀ u x, x ∈ N → A u x ∈ N)
    (hm : ∀ o x, x ∈ N → m o x = 0) : N ≤ silent A m := by
  intro x hx
  rw [mem_silent_iff]
  intro w o
  exact hm o _ (invariant_future A N hN w x hx)

/-- Quotient coordinates advance without reconstructing discarded history. -/
def reducedStep (A : U → E →ₗ[ℝ] E) (m : O → E →ₗ[ℝ] ℝ) (u : U) :
    (E ⧸ silent A m) →ₗ[ℝ] (E ⧸ silent A m) :=
  (silent A m).mapQ (silent A m) (A u)
    (by intro x hx; exact silent_is_invariant A m u x hx)

def reducedRead (A : U → E →ₗ[ℝ] E) (m : O → E →ₗ[ℝ] ℝ) (o : O) :
    (E ⧸ silent A m) →ₗ[ℝ] ℝ :=
  (silent A m).liftQ (m o)
    (by intro x hx; exact silent_reads_zero A m x hx o)

theorem reduced_step_exact (A : U → E →ₗ[ℝ] E) (m : O → E →ₗ[ℝ] ℝ)
    (u : U) (x : E) :
    reducedStep A m u ((silent A m).mkQ x) = (silent A m).mkQ (A u x) := rfl

theorem reduced_read_exact (A : U → E →ₗ[ℝ] E) (m : O → E →ₗ[ℝ] ℝ)
    (o : O) (x : E) : reducedRead A m o ((silent A m).mkQ x) = m o x := rfl

/-- A new actual participation source is compressed by the SAME map. -/
theorem reduced_source_step_exact (A : U → E →ₗ[ℝ] E)
    (m : O → E →ₗ[ℝ] ℝ) (u : U) (x b : E) :
    reducedStep A m u ((silent A m).mkQ x) + (silent A m).mkQ b =
      (silent A m).mkQ (A u x + b) := by
  rw [reduced_step_exact, map_add]

/-- Any other exact linear code, even with a nonlinear decoder, can discard
no direction outside the silent subspace for the SAME future-test family. -/
theorem exact_code_kernel_le_silent (A : U → E →ₗ[ℝ] E)
    (m : O → E →ₗ[ℝ] ℝ) (P : E →ₗ[ℝ] Q)
    (decode : Q → List U → O → ℝ)
    (correct : ∀ x w o, decode (P x) w o = m o (futureMap A w x)) :
    LinearMap.ker P ≤ silent A m := by
  intro x hx
  rw [mem_silent_iff]
  intro w o
  have heq : P x = 0 := hx
  rw [← correct x w o, heq]
  simpa using correct 0 w o

/-- Two histories with an observable future difference cannot be merged by
an exact code. The relevant distinction is future CREDIT, not old bytes. -/
theorem future_credit_difference_forces_distinct_codes
    (A : U → E →ₗ[ℝ] E) (m : O → E →ₗ[ℝ] ℝ) (P : E →ₗ[ℝ] Q)
    (decode : Q → List U → O → ℝ)
    (correct : ∀ x w o, decode (P x) w o = m o (futureMap A w x))
    (x y : E) (w : List U) (o : O)
    (different : m o (futureMap A w x) ≠ m o (futureMap A w y)) : P x ≠ P y := by
  intro same
  apply different
  rw [← correct x w o, ← correct y w o, same]

end Observable

section Factor

variable {E K L B P : Type*} [AddCommGroup E] [Module ℝ E]
    [Fintype K] [Fintype L] [Fintype B]

/-- Shared effect basis U, separate parameter/participation ownership V.
The owner alphabet P is fixed by the selected learning contract. -/
def factor (U : K → E) (V : K → P → ℝ) (p : P) : E :=
  ∑ k, (V k p) • U k

/-- Delayed modulation captures each owner's responsibility by contracting
the shared effect basis once, then reading its ownership coefficients. -/
theorem factored_capture (U : K → E) (V : K → P → ℝ)
    (m : E →ₗ[ℝ] ℝ) (p : P) :
    m (factor U V p) = ∑ k, V k p * m (U k) := by
  simp [factor]

/-- Future native/record transport acts on the shared basis; no past
trajectory or old parameter graph is needed by this algebra. -/
theorem factor_transport (A : E →ₗ[ℝ] E) (U : K → E) (V : K → P → ℝ) (p : P) :
    A (factor U V p) = factor (fun k => A (U k)) V p := by
  simp [factor]

/-- The concrete in-span insertion rule changes ownership coefficients,
not the effect basis. Repeated useful participation need not consume a new
slot when its causal effect is already represented. -/
theorem in_span_source_absorbed (U : K → E) (V : K → P → ℝ)
    (coeff : K → ℝ) (owner : P → ℝ) (p : P) :
    factor U (fun k p => V k p + coeff k * owner p) p =
      factor U V p + owner p • (∑ k, coeff k • U k) := by
  simp only [factor, add_smul, Finset.sum_add_distrib, Finset.smul_sum, smul_smul]
  congr 1
  apply Finset.sum_congr rfl
  intro k _
  rw [mul_comm]

/-- For an arbitrary candidate source, the exact omitted component is its
residual outside the present basis. This is a checkable error object, not a
claim that every candidate is low rank. -/
theorem source_absorption_residual (U : K → E) (V : K → P → ℝ)
    (coeff : K → ℝ) (owner : P → ℝ) (source : E) (p : P) :
    factor U V p + owner p • source -
      factor U (fun k p => V k p + coeff k * owner p) p =
      owner p • (source - ∑ k, coeff k • U k) := by
  rw [in_span_source_absorbed, smul_sub]
  abel

/-- A nonzero state residual may still be safely merged if every registered
future result is blind to it. This joins future-credit sufficiency to the
constructive ownership-preserving insertion rule. -/
theorem silent_residual_merge_exact {Future Outcome : Type*}
    (A : Future → E →ₗ[ℝ] E) (m : Outcome → E →ₗ[ℝ] ℝ)
    (U : K → E) (V : K → P → ℝ) (coeff : K → ℝ)
    (owner : P → ℝ) (source : E)
    (hsilent : source - ∑ k, coeff k • U k ∈ silent A m)
    (p : P) (w : List Future) (o : Outcome) :
    m o (futureMap A w (factor U V p + owner p • source)) =
      m o (futureMap A w (factor U (fun k p => V k p + coeff k * owner p) p)) := by
  have hzero := (mem_silent_iff A m _).mp hsilent w o
  have hzero' : m o (futureMap A w source) -
      m o (futureMap A w (∑ k, coeff k • U k)) = 0 := by
    simpa only [map_sub] using hzero
  have h := congrArg (fun x => m o (futureMap A w x))
    (source_absorption_residual U V coeff owner source p)
  simp only [map_sub, map_smul, hzero', smul_zero] at h
  exact sub_eq_zero.mp h

/-- The current basis can be changed only together with its ownership
factor. This is the exact rule for merging dependent participation effects. -/
theorem basis_recompression_exact (U : K → E) (V : K → P → ℝ)
    (newU : B → E) (coeff : B → K → ℝ)
    (hspan : ∀ k, U k = ∑ b, coeff b k • newU b) (p : P) :
    factor U V p = factor newU (fun b p => ∑ k, coeff b k * V k p) p := by
  unfold factor
  simp_rw [hspan, Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro b _
  rw [Finset.sum_smul]
  apply Finset.sum_congr rfl
  intro k _
  congr 1
  ring

/-- A finite temporary append represents transported old effects plus new
participation sources. It has K+L columns, not a growing event list. -/
theorem append_sources_exact (A : E →ₗ[ℝ] E) (U : K → E) (V : K → P → ℝ)
    (source : L → E) (owner : L → P → ℝ) (p : P) :
    A (factor U V p) + factor source owner p =
      factor (Sum.elim (fun k => A (U k)) source) (Sum.elim V owner) p := by
  simp [factor, Fintype.sum_sum_type]

/-- Fixed-capacity exact step IF the combined source/transport rank fits.
No theorem here supplies that span for arbitrary GDN projections or worlds. -/
theorem bounded_factor_step (A : E →ₗ[ℝ] E) (U : K → E) (V : K → P → ℝ)
    (source : L → E) (owner : L → P → ℝ) (newU : B → E)
    (coeff : B → (K ⊕ L) → ℝ)
    (hspan : ∀ j, Sum.elim (fun k => A (U k)) source j =
      ∑ b, coeff b j • newU b) (p : P) :
    A (factor U V p) + factor source owner p =
      factor newU (fun b p => ∑ j, coeff b j * Sum.elim V owner j p) p := by
  rw [append_sources_exact]
  exact basis_recompression_exact _ _ newU coeff hspan p

/-- Observable captures do not change under an admitted basis rotation. -/
theorem recompression_preserves_capture (U : K → E) (V : K → P → ℝ)
    (newU : B → E) (coeff : B → K → ℝ)
    (hspan : ∀ k, U k = ∑ b, coeff b k • newU b)
    (m : E →ₗ[ℝ] ℝ) (p : P) :
    m (factor U V p) = ∑ b, (∑ k, coeff b k * V k p) * m (newU b) := by
  rw [basis_recompression_exact U V newU coeff hspan p, factored_capture]

end Factor

/-- Summing opposing effects while dropping their parameter identities
destroys responsibility, even when the summed effect is exactly zero. This
is a logical countermodel, not a synthetic capability experiment. -/
theorem ownership_cannot_be_replaced_by_total :
    ¬ ∃ read : ℝ → ℝ, ∀ x : Bool → ℝ, read (x false + x true) = x false := by
  rintro ⟨read, h⟩
  have h₀ := h (fun _ => 0)
  have h₁ := h (fun b => if b then -1 else 1)
  norm_num at h₀ h₁
  linarith

section Approximate

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Truncation/quantization must be judged after the REAL outcome read, not
only by a small latent-space reconstruction error or by SIGReg variance. -/
theorem capture_error_bound (m : E →L[ℝ] ℝ) (full approximate : E) :
    |m full - m approximate| ≤ ‖m‖ * ‖full - approximate‖ := by
  simpa only [map_sub, Real.norm_eq_abs] using m.le_opNorm (full - approximate)

/-- Direct error certificate for the actual in-span insertion rule above.
If the source residual is truncated, each owner's delayed credit carries
its OWN coefficient in the bound. A low norm for the shared basis alone is
not a uniform guarantee for arbitrary ownership weights. -/
theorem source_capture_error {K P : Type*} [Fintype K]
    (U : K → E) (V : K → P → ℝ) (coeff : K → ℝ)
    (owner : P → ℝ) (source : E) (m : E →L[ℝ] ℝ) (p : P) :
    |m (factor U V p + owner p • source) -
      m (factor U (fun k p => V k p + coeff k * owner p) p)| ≤
      ‖m‖ * (|owner p| * ‖source - ∑ k, coeff k • U k‖) := by
  have h := capture_error_bound m (factor U V p + owner p • source)
    (factor U (fun k p => V k p + coeff k * owner p) p)
  rw [source_absorption_residual, norm_smul, Real.norm_eq_abs] at h
  exact h

/-- A positive approximate credit is directionally safe only with a margin
over its certified error. Near-zero/noisy credit does not pass this gate. -/
theorem positive_capture_of_error_margin (credit estimate error : ℝ)
    (herror : |credit - estimate| ≤ error) (hmargin : error < estimate) :
    0 < credit := by
  have h := (abs_le.mp herror).1
  linarith

theorem negative_capture_of_error_margin (credit estimate error : ℝ)
    (herror : |credit - estimate| ≤ error) (hmargin : estimate < -error) :
    credit < 0 := by
  have h := (abs_le.mp herror).2
  linarith

/-- For the original NLL boundary, uniform logit-DIRECTION error epsilon
implies credit error at most 2*epsilon. No vocabulary-sized independent
reward scalars or private layer targets are required. Probabilities are those
of the same held forward pass; a changed forward needs an extra error term. -/
theorem nll_capture_error_bound {V : Type*} [Fintype V]
    (prob full approximate : V → ℝ) (target : V) (ε : ℝ)
    (hp : ∀ i, 0 ≤ prob i) (hs : ∑ i, prob i = 1)
    (he : ∀ i, |full i - approximate i| ≤ ε) :
    |((∑ i, prob i * full i) - full target) -
      ((∑ i, prob i * approximate i) - approximate target)| ≤ 2 * ε := by
  calc
    _ = |(∑ i, prob i * (full i - approximate i)) -
        (full target - approximate target)| := by
          congr 1
          simp_rw [mul_sub]
          rw [Finset.sum_sub_distrib]
          ring
    _ ≤ |∑ i, prob i * (full i - approximate i)| +
        |full target - approximate target| := abs_sub _ _
    _ ≤ (∑ i, |prob i * (full i - approximate i)|) + ε :=
      add_le_add (Finset.abs_sum_le_sum_abs _ _) (he target)
    _ ≤ (∑ i, prob i * ε) + ε := by
      apply add_le_add _ le_rfl
      apply Finset.sum_le_sum
      intro i _
      rw [abs_mul, abs_of_nonneg (hp i)]
      exact mul_le_mul_of_nonneg_left (he i) (hp i)
    _ = 2 * ε := by rw [← Finset.sum_mul, hs]; ring

/-- Old age alone is not the certificate. This states the explicit
contraction/defect condition that makes a fixed error budget invariant for
every finite continuation of the same registered dynamics. -/
theorem bounded_error_over_lifetime {X Z W : Type*}
    (reference : X → W → X) (reduced : Z → W → Z) (error : X → Z → ℝ)
    (L defect budget : ℝ) (hL : 0 ≤ L)
    (hstep : ∀ x z u, error (reference x u) (reduced z u) ≤ L * error x z + defect)
    (hclosed : L * budget + defect ≤ budget)
    (x : X) (z : Z) (initial : error x z ≤ budget) (inputs : List W) :
    error (inputs.foldl reference x) (inputs.foldl reduced z) ≤ budget :=
  CGB.LanguageLifeKernel.Approximation.invariant_error reference reduced error
    L defect budget hL hstep hclosed x z initial inputs

end Approximate

section FiniteInsertion

variable {E P : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {K : ℕ}

/-- Fixed storage: shared effects, original ownership, and a uniform error
radius. No event-indexed tape or past optimizer state is a field. -/
structure Code (K : ℕ) (P E : Type*) where
  effect : Fin K → E
  owner : Fin K → P → ℝ
  radius : ℝ

def expansion (U : Fin K → E) (a : Fin K → ℝ) : E := ∑ j, a j • U j

def bump (a : Fin K → ℝ) (j : Fin K) (c : ℝ) : Fin K → ℝ :=
  fun i => a i + if i = j then c else 0

/-- A scalar ownership increment and its removed residual exactly balance. -/
theorem expansion_bump (U : Fin K → E) (a : Fin K → ℝ) (j : Fin K) (c : ℝ) :
    expansion U (bump a j c) = expansion U a + c • U j := by
  simp only [expansion, bump, add_smul, Finset.sum_add_distrib]
  congr 1
  simp [ite_smul]

/-- One finite scalar projection. Real division by zero returns zero; a
numerical implementation must explicitly branch on an empty/zero column. -/
noncomputable def projectOne (U : Fin K → E) (s : (Fin K → ℝ) × E)
    (j : Fin K) : (Fin K → ℝ) × E :=
  let c := inner ℝ (U j) s.2 / ‖U j‖ ^ 2
  (bump s.1 j c, s.2 - c • U j)

/-- No orthonormal-basis premise is used for this conservation identity.
One sweep need not be the least-squares projection onto the entire span. -/
theorem project_one_conserves (U : Fin K → E) (s : (Fin K → ℝ) × E)
    (j : Fin K) :
    expansion U (projectOne U s j).1 + (projectOne U s j).2 = expansion U s.1 + s.2 := by
  dsimp [projectOne]
  rw [expansion_bump]
  abel

/-- A bounded scan through columns preserves source = expansion + residual,
even for nonorthogonal columns. Coefficients and residual are temporary. -/
theorem projection_sweep_conserves (U : Fin K → E) (js : List (Fin K))
    (s : (Fin K → ℝ) × E) :
    expansion U (js.foldl (projectOne U) s).1 +
      (js.foldl (projectOne U) s).2 = expansion U s.1 + s.2 := by
  induction js generalizing s with
  | nil => rfl
  | cons j js ih =>
    rw [List.foldl_cons, ih, project_one_conserves]

noncomputable def projectSource (U : Fin K → E) (source : E) : (Fin K → ℝ) × E :=
  (List.finRange K).foldl (projectOne U) (fun _ => 0, source)

/-- The concrete K-projection sweep supplies the residual identity needed
by the earlier absorption theorem; it is not an unspecified compression oracle. -/
theorem project_source_split (U : Fin K → E) (source : E) :
    source = expansion U (projectSource U source).1 + (projectSource U source).2 := by
  have h := projection_sweep_conserves U (List.finRange K) (fun _ => 0, source)
  simpa [projectSource, expansion] using h.symm

def replaceCode (U : Fin K → E) (W : Fin K → P → ℝ) (r : E)
    (owner : P → ℝ) (drop : Option (Fin K)) (radius : ℝ) : Code K P E :=
  match drop with
  | none => ⟨U, W, radius⟩
  | some j => ⟨Function.update U j r, Function.update W j owner, radius⟩

def discarded (U : Fin K → E) (W : Fin K → P → ℝ) (r : E)
    (owner : P → ℝ) (drop : Option (Fin K)) (p : P) : E :=
  match drop with
  | none => owner p • r
  | some j => W j p • U j

/-- Replacing a single column also replaces its ownership row. The dropped
object is the OLD column with its already-merged ownership, not a bare activity. -/
theorem factor_replace_column (U : Fin K → E) (W : Fin K → P → ℝ)
    (r : E) (owner : P → ℝ) (j : Fin K) (p : P) :
    factor (Function.update U j r) (Function.update W j owner) p =
      factor U W p - W j p • U j + owner p • r := by
  classical
  have h : (fun i => Function.update W j owner i p • Function.update U j r i) =
      Function.update (fun i => W i p • U i) j (owner p • r) := by
    funext i
    by_cases hi : i = j <;> simp [hi]
  unfold factor
  rw [h, Finset.sum_update_of_mem (Finset.mem_univ j)]
  rw [← Finset.sum_erase_add _ _ (Finset.mem_univ j)]
  simp only [Finset.sdiff_singleton_eq_erase]
  abel

/-- All K+1 discard candidates have an exact residual, including exchange.
The residual is used in proofs/temporary computation, not saved as extra history. -/
theorem discard_identity (U : Fin K → E) (W : Fin K → P → ℝ)
    (r : E) (owner : P → ℝ) (drop : Option (Fin K)) (radius : ℝ) (p : P) :
    factor U W p + owner p • r -
      factor (replaceCode U W r owner drop radius).effect
        (replaceCode U W r owner drop radius).owner p = discarded U W r owner drop p := by
  cases drop with
  | none => simp [replaceCode, discarded]
  | some j =>
    simp only [replaceCode, discarded]
    rw [factor_replace_column]
    abel

variable [Fintype P] [Nonempty P]

noncomputable def ownerMax (v : P → ℝ) : ℝ :=
  Finset.univ.sup' Finset.univ_nonempty (fun p => |v p|)

/-- Uniform ownership bound over the fixed parameter alphabet, not event IDs. -/
theorem owner_le_max (v : P → ℝ) (p : P) : |v p| ≤ ownerMax v := by
  exact Finset.le_sup' (f := fun p => |v p|) (Finset.mem_univ p)

noncomputable def discardCost (U : Fin K → E) (W : Fin K → P → ℝ)
    (r : E) (owner : P → ℝ) : Option (Fin K) → ℝ
  | none => ownerMax owner * ‖r‖
  | some j => ownerMax (W j) * ‖U j‖

/-- Cost bounds the lost causal action for EVERY owner. A tiny unweighted
column can still be expensive when its ownership coefficients are large. -/
theorem discarded_norm_le_cost (U : Fin K → E) (W : Fin K → P → ℝ)
    (r : E) (owner : P → ℝ) (drop : Option (Fin K)) (p : P) :
    ‖discarded U W r owner drop p‖ ≤ discardCost U W r owner drop := by
  cases drop with
  | none =>
    simp only [discarded, discardCost, norm_smul, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_right (owner_le_max owner p) (norm_nonneg _)
  | some j =>
    simp only [discarded, discardCost, norm_smul, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_right (owner_le_max (W j) p) (norm_nonneg _)

noncomputable def chooseOne (cost : Option (Fin K) → ℝ)
    (best : Option (Fin K)) (j : Fin K) : Option (Fin K) :=
  if cost (some j) < cost best then some j else best

noncomputable def chooseDrop (cost : Option (Fin K) → ℝ) : Option (Fin K) :=
  (List.finRange K).foldl (chooseOne cost) none

/-- The finite scan never increases the selected certified discard cost. -/
theorem scan_cost_le_initial (cost : Option (Fin K) → ℝ) (js : List (Fin K))
    (best : Option (Fin K)) :
    cost (js.foldl (chooseOne cost) best) ≤ cost best := by
  induction js generalizing best with
  | nil => exact le_rfl
  | cons j js ih =>
    change cost (js.foldl (chooseOne cost) (chooseOne cost best j)) ≤ cost best
    apply (ih _).trans
    dsimp [chooseOne]
    split_ifs with h
    · exact h.le
    · exact le_rfl

/-- Every old-column exchange is considered, with deterministic scan order. -/
theorem scan_cost_le_member (cost : Option (Fin K) → ℝ) (js : List (Fin K))
    (best : Option (Fin K)) (j : Fin K) (hj : j ∈ js) :
    cost (js.foldl (chooseOne cost) best) ≤ cost (some j) := by
  induction js generalizing best with
  | nil => simp at hj
  | cons i js ih =>
    change cost (js.foldl (chooseOne cost) (chooseOne cost best i)) ≤ cost (some j)
    rcases List.mem_cons.mp hj with h | h
    · subst i
      apply (scan_cost_le_initial cost js _).trans
      dsimp [chooseOne]
      split_ifs with h
      · exact le_rfl
      · exact le_of_not_gt h
    · exact ih _ h

/-- The chosen truncation has the smallest bound among keeping the old
basis and ALL single-column exchanges; not a global optimal-rank claim. -/
theorem chosen_cost_minimal (cost : Option (Fin K) → ℝ) (candidate : Option (Fin K)) :
    cost (chooseDrop cost) ≤ cost candidate := by
  cases candidate with
  | none => exact scan_cost_le_initial cost (List.finRange K) none
  | some j => exact scan_cost_le_member cost (List.finRange K) none j (by simp)

noncomputable def pendingOwner (c : Code K P E) (source : E) (owner : P → ℝ) :
    Fin K → P → ℝ :=
  fun j p => c.owner j p + (projectSource c.effect source).1 j * owner p

noncomputable def pendingCost (c : Code K P E) (source : E) (owner : P → ℝ) :
    Option (Fin K) → ℝ :=
  discardCost c.effect (pendingOwner c source owner)
    (projectSource c.effect source).2 owner

/-- Concrete fixed-K insert: project in finite scan order, merge ownership,
then discard the cheapest of K+1 certified candidates. Radius records the loss. -/
noncomputable def insertCode (c : Code K P E) (source : E) (owner : P → ℝ) : Code K P E :=
  let cost := pendingCost c source owner
  replaceCode c.effect (pendingOwner c source owner) (projectSource c.effect source).2
    owner (chooseDrop cost) (c.radius + cost (chooseDrop cost))

noncomputable def insertDefect (c : Code K P E) (source : E) (owner : P → ℝ) (p : P) : E :=
  discarded c.effect (pendingOwner c source owner) (projectSource c.effect source).2
    owner (chooseDrop (pendingCost c source owner)) p

/-- Exact accounting for the entire chosen insertion, not just an abstract
low-rank existence premise. The defect is an analytical reference, not storage. -/
theorem insert_defect_identity (c : Code K P E) (source : E) (owner : P → ℝ) (p : P) :
    factor c.effect c.owner p + owner p • source -
      factor (insertCode c source owner).effect (insertCode c source owner).owner p =
        insertDefect c source owner p := by
  have hsplit := project_source_split c.effect source
  have hr : source - expansion c.effect (projectSource c.effect source).1 =
      (projectSource c.effect source).2 := by
    exact sub_eq_iff_eq_add.mpr (hsplit.trans (add_comm _ _))
  have hab := source_absorption_residual c.effect c.owner
    (projectSource c.effect source).1 owner source p
  change factor c.effect c.owner p + owner p • source -
    factor c.effect (pendingOwner c source owner) p =
      owner p • (source - expansion c.effect (projectSource c.effect source).1) at hab
  rw [hr] at hab
  have hab' := sub_eq_iff_eq_add.mp hab
  rw [hab', add_comm (owner p • (projectSource c.effect source).2)]
  exact discard_identity _ _ _ _ _ _ p

/-- Radius changes by the computed discard bound, never by unreported loss. -/
theorem insert_radius (c : Code K P E) (source : E) (owner : P → ℝ) :
    (insertCode c source owner).radius =
      c.radius + pendingCost c source owner (chooseDrop (pendingCost c source owner)) := by
  unfold insertCode
  dsimp only
  cases chooseDrop (pendingCost c source owner) <;> rfl

/-- Every owner's actual insertion defect is bounded by the chosen cost. -/
theorem insert_defect_bound (c : Code K P E) (source : E) (owner : P → ℝ) (p : P) :
    ‖insertDefect c source owner p‖ ≤
      pendingCost c source owner (chooseDrop (pendingCost c source owner)) :=
  discarded_norm_le_cost _ _ _ _ _ p

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- Fieldwise defect bound for the SAME chosen insertion. Basis and ownership
do not change; each native/record/pending field may keep a sharper error ledger. -/
noncomputable def fieldInsertCost (π : E →L[ℝ] F) (c : Code K P E)
    (source : E) (owner : P → ℝ) : ℝ :=
  match chooseDrop (pendingCost c source owner) with
  | none => ownerMax owner * ‖π (projectSource c.effect source).2‖
  | some j => ownerMax (pendingOwner c source owner j) * ‖π (c.effect j)‖

/-- A sparse field projection can certify less loss than the full-state
radius. The loss is exactly zero when the discarded direction has zero
projection into this field, even if another field has a large defect. -/
theorem field_insert_defect_bound (π : E →L[ℝ] F) (c : Code K P E)
    (source : E) (owner : P → ℝ) (p : P) :
    ‖π (insertDefect c source owner p)‖ ≤ fieldInsertCost π c source owner := by
  cases hd : chooseDrop (pendingCost c source owner) with
  | none =>
    simp only [insertDefect, fieldInsertCost, hd, discarded, map_smul, norm_smul, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_right (owner_le_max owner p) (norm_nonneg _)
  | some j =>
    simp only [insertDefect, fieldInsertCost, hd, discarded, map_smul, norm_smul, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_right (owner_le_max (pendingOwner c source owner j) p) (norm_nonneg _)

/-- The finite Code insertion and a fieldwise record-gain ledger are jointly
valid: they refer to exactly the same discarded effect and original owners. -/
theorem field_insert_error_certificate (π : E →L[ℝ] F) (full : P → E)
    (c : Code K P E) (fieldRadius : ℝ)
    (h : ∀ p, ‖π (full p - factor c.effect c.owner p)‖ ≤ fieldRadius)
    (source : E) (owner : P → ℝ) (p : P) :
    ‖π (full p + owner p • source -
      factor (insertCode c source owner).effect (insertCode c source owner).owner p)‖ ≤
        fieldRadius + fieldInsertCost π c source owner := by
  have heq : full p + owner p • source -
      factor (insertCode c source owner).effect (insertCode c source owner).owner p =
      (full p - factor c.effect c.owner p) + insertDefect c source owner p := by
    rw [← insert_defect_identity]
    abel
  rw [heq, map_add]
  exact (norm_add_le _ _).trans (add_le_add (h p) (field_insert_defect_bound π c source owner p))

/-- Zero-cost absorption or an empty old slot is lossless whichever tied
candidate the fixed scan selects. This requires a zero-cost candidate;
one projection sweep does not promise to find every span representation. -/
theorem zero_cost_insert_exact (c : Code K P E) (source : E) (owner : P → ℝ)
    (candidate : Option (Fin K)) (hz : pendingCost c source owner candidate = 0) (p : P) :
    factor (insertCode c source owner).effect (insertCode c source owner).owner p =
      factor c.effect c.owner p + owner p • source := by
  have h := (insert_defect_bound c source owner p).trans
    (chosen_cost_minimal (pendingCost c source owner) candidate)
  rw [hz] at h
  have hd : insertDefect c source owner p = 0 := norm_eq_zero.mp (le_antisymm h (norm_nonneg _))
  have hi := insert_defect_identity c source owner p
  rw [hd] at hi
  exact (sub_eq_zero.mp hi).symm

/-- The same concrete insertion carries a valid error radius for the unknown
uncompressed participation map; it does not need that map at runtime. -/
theorem insert_error_certificate (full : P → E) (c : Code K P E)
    (h : ∀ p, ‖full p - factor c.effect c.owner p‖ ≤ c.radius)
    (source : E) (owner : P → ℝ) (p : P) :
    ‖full p + owner p • source -
      factor (insertCode c source owner).effect (insertCode c source owner).owner p‖ ≤
        (insertCode c source owner).radius := by
  have heq : full p + owner p • source -
      factor (insertCode c source owner).effect (insertCode c source owner).owner p =
      (full p - factor c.effect c.owner p) + insertDefect c source owner p := by
    rw [← insert_defect_identity]
    abel
  rw [heq, insert_radius]
  exact (norm_add_le _ _).trans (add_le_add (h p) (insert_defect_bound c source owner p))

noncomputable def transportCode (A : E →L[ℝ] E) (gain : ℝ) (c : Code K P E) : Code K P E :=
  ⟨fun j => A (c.effect j), c.owner, gain * c.radius⟩

omit [Fintype P] [Nonempty P] in
/-- Transport acts on the shared effects once and amplifies the LOST part
by the actual joint operator bound. Native-only contraction is insufficient. -/
theorem transport_error_certificate (A : E →L[ℝ] E) (full : P → E)
    (c : Code K P E) (h : ∀ p, ‖full p - factor c.effect c.owner p‖ ≤ c.radius)
    (gain : ℝ) (hgain : 0 ≤ gain) (hA : ‖A‖ ≤ gain) (p : P) :
    ‖A (full p) - factor (transportCode A gain c).effect (transportCode A gain c).owner p‖ ≤
      (transportCode A gain c).radius := by
  change ‖A (full p) - factor (fun j => A (c.effect j)) c.owner p‖ ≤ gain * c.radius
  have hf : factor (fun j => A (c.effect j)) c.owner p = A (factor c.effect c.owner p) :=
    (factor_transport A.toLinearMap c.effect c.owner p).symm
  rw [hf, ← map_sub]
  exact (A.le_opNorm _).trans ((mul_le_mul_of_nonneg_right hA (norm_nonneg _)).trans
    (mul_le_mul_of_nonneg_left (h p) hgain))

def addSource (full : P → E) (s : E × (P → ℝ)) : P → E :=
  fun p => full p + s.2 p • s.1

noncomputable def insertSource (c : Code K P E) (s : E × (P → ℝ)) : Code K P E :=
  insertCode c s.1 s.2

/-- Process all current sources sequentially, retaining exactly K columns.
The reference is for proof only; the stored code has no growing source list. -/
theorem insert_list_certificate (sources : List (E × (P → ℝ))) (full : P → E)
    (c : Code K P E) (h : ∀ p, ‖full p - factor c.effect c.owner p‖ ≤ c.radius) (p : P) :
    ‖(sources.foldl addSource full) p -
      factor (sources.foldl insertSource c).effect (sources.foldl insertSource c).owner p‖ ≤
        (sources.foldl insertSource c).radius := by
  induction sources generalizing full c with
  | nil => exact h p
  | cons s ss ih =>
    simp only [List.foldl_cons]
    exact ih _ _ (insert_error_certificate full c h s.1 s.2)

/-- A whole registered event has one joint transport and finitely many new
sources. All insertion defects remain in the error ledger; no reset is used. -/
theorem finite_step_certificate (A : E →L[ℝ] E) (sources : List (E × (P → ℝ)))
    (full : P → E) (c : Code K P E)
    (h : ∀ p, ‖full p - factor c.effect c.owner p‖ ≤ c.radius)
    (gain : ℝ) (hgain : 0 ≤ gain) (hA : ‖A‖ ≤ gain) (p : P) :
    ‖(sources.foldl addSource (fun p => A (full p))) p -
      factor (sources.foldl insertSource (transportCode A gain c)).effect
        (sources.foldl insertSource (transportCode A gain c)).owner p‖ ≤
      (sources.foldl insertSource (transportCode A gain c)).radius :=
  insert_list_certificate sources _ _ (transport_error_certificate A full c h gain hgain hA) p

/-- The finite insertion bill is computed from the selected candidates, not
an assumed uniform defect. Only the running scalar total must be retained. -/
noncomputable def insertionBill (c : Code K P E) : List (E × (P → ℝ)) → ℝ
  | [] => 0
  | s :: ss => pendingCost c s.1 s.2 (chooseDrop (pendingCost c s.1 s.2)) +
      insertionBill (insertSource c s) ss

/-- Exact radius recurrence of the implemented finite source scan. -/
theorem insertion_bill_radius (sources : List (E × (P → ℝ))) (c : Code K P E) :
    (sources.foldl insertSource c).radius = c.radius + insertionBill c sources := by
  induction sources generalizing c with
  | nil => simp [insertionBill]
  | cons s ss ih =>
    rw [List.foldl_cons, ih]
    change (insertCode c s.1 s.2).radius + insertionBill (insertSource c s) ss = _
    rw [insert_radius]
    simp only [insertionBill]
    ring

/-- When the actual chosen truncations satisfy the closed budget inequality,
the same fixed-K code keeps its error budget. No small-rank premise is hidden. -/
theorem finite_step_closed_budget (A : E →L[ℝ] E) (gain budget : ℝ) (hgain : 0 ≤ gain)
    (sources : List (E × (P → ℝ))) (c : Code K P E) (hc : c.radius ≤ budget)
    (hclosed : gain * budget + insertionBill (transportCode A gain c) sources ≤ budget) :
    (sources.foldl insertSource (transportCode A gain c)).radius ≤ budget := by
  rw [insertion_bill_radius]
  change gain * c.radius + insertionBill (transportCode A gain c) sources ≤ budget
  exact (add_le_add (mul_le_mul_of_nonneg_left hc hgain) le_rfl).trans hclosed

omit [Fintype P] [Nonempty P] in
/-- Subtracting the SAME current-window participation does not enlarge total
credit error. The recent scalar can come from the existing bounded graph. -/
theorem matched_recent_subtraction (total estimate recent error : ℝ)
    (h : |total - estimate| ≤ error) :
    |(total - recent) - (estimate - recent)| ≤ error := by
  have heq : (total - recent) - (estimate - recent) = total - estimate := by ring
  rw [heq]
  exact h

omit [Fintype P] [Nonempty P] in
/-- A mismatched current-window reference contributes an additional error;
actual-history sources and a different replay-weight schedule cannot cancel. -/
theorem mismatched_recent_subtraction (total estimate recent used error mismatch : ℝ)
    (h : |total - estimate| ≤ error) (hr : |recent - used| ≤ mismatch) :
    |(total - recent) - (estimate - used)| ≤ error + mismatch := by
  calc
    _ = |(total - estimate) - (recent - used)| := by congr 1; ring
    _ ≤ |total - estimate| + |recent - used| := abs_sub _ _
    _ ≤ error + mismatch := add_le_add h hr

omit [Fintype P] [Nonempty P] in
/-- An arrived real boundary contracts the CURRENT error, so a stored code
may keep evolving even when its bound is too large to certify useful credit. -/
theorem arrived_credit_certificate (m : E →L[ℝ] ℝ) (full : P → E)
    (c : Code K P E) (h : ∀ p, ‖full p - factor c.effect c.owner p‖ ≤ c.radius) (p : P) :
    |m (full p) - m (factor c.effect c.owner p)| ≤ ‖m‖ * c.radius := by
  exact (capture_error_bound m _ _).trans
    (mul_le_mul_of_nonneg_left (h p) (norm_nonneg _))

noncomputable def certifiedCredit (c : Code K P E) (m : E →L[ℝ] ℝ) (p : P) : ℝ :=
  let estimate := m (factor c.effect c.owner p)
  if ‖m‖ * c.radius < |estimate| then estimate else 0

omit [Fintype P] [Nonempty P] in
/-- An accepted sign agrees with the registered participation credit;
uncertain credit contributes zero. This is NOT a full-parameter Adam theorem. -/
theorem certified_credit_alignment (m : E →L[ℝ] ℝ) (full : P → E)
    (c : Code K P E) (h : ∀ p, ‖full p - factor c.effect c.owner p‖ ≤ c.radius) (p : P) :
    0 ≤ m (full p) * certifiedCredit c m p := by
  have he := arrived_credit_certificate m full c h p
  unfold certifiedCredit
  dsimp
  split_ifs with hm
  · by_cases hp : 0 ≤ m (factor c.effect c.owner p)
    · rw [abs_of_nonneg hp] at hm
      exact mul_nonneg (positive_capture_of_error_margin _ _ _ he hm).le hp
    · have hn := lt_of_not_ge hp
      rw [abs_of_neg hn] at hm
      have hg : m (full p) < 0 := negative_capture_of_error_margin _ _ _ he (by linarith)
      exact mul_nonneg_of_nonpos_of_nonpos hg.le hn.le
  · simp

omit [Nonempty P] in
/-- A negative step along certified credit has a nonpositive first-order
pairing with the SELECTED source reference. Other source legs and finite-step
curvature still belong in any actual parameter-update acceptance test. -/
theorem certified_selected_pairing (m : E →L[ℝ] ℝ) (full : P → E)
    (c : Code K P E) (h : ∀ p, ‖full p - factor c.effect c.owner p‖ ≤ c.radius)
    (η : ℝ) (hη : 0 ≤ η) :
    ∑ p, m (full p) * (-η * certifiedCredit c m p) ≤ 0 := by
  apply Finset.sum_nonpos
  intro p _
  have hp := mul_nonneg hη (certified_credit_alignment m full c h p)
  calc
    _ = -(η * (m (full p) * certifiedCredit c m p)) := by ring
    _ ≤ 0 := neg_nonpos.mpr hp

end FiniteInsertion

section NumericalAdmission

variable {E K P : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [Fintype K]

/-- Both effect storage U and ownership storage V contribute error. Treat
rounded FP32/FP16 values as exact real bit-pattern values here; obtaining
their enclosures, including underflow/overflow, is a numerical obligation. -/
theorem rounded_factor_error (U roundedU : K → E) (V roundedV : K → P → ℝ) (p : P) :
    ‖factor U V p - factor roundedU roundedV p‖ ≤
      ∑ k, (|V k p| * ‖U k - roundedU k‖ +
        |V k p - roundedV k p| * ‖roundedU k‖) := by
  have hid : factor U V p - factor roundedU roundedV p =
      ∑ k, (V k p • (U k - roundedU k) + (V k p - roundedV k p) • roundedU k) := by
    simp only [factor, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro k _
    module
  rw [hid]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum (fun k _ => ?_))
  simpa only [norm_smul, Real.norm_eq_abs] using
    norm_add_le (V k p • (U k - roundedU k)) ((V k p - roundedV k p) • roundedU k)

/-- A stored basis error is not just the loss from discarded columns. The
same field projections may be applied before this formula for sparse bills. -/
theorem compression_plus_storage_error (full : E) (U roundedU : K → E)
    (V roundedV : K → P → ℝ) (p : P) (rho : ℝ)
    (h : ‖full - factor U V p‖ ≤ rho) :
    ‖full - factor roundedU roundedV p‖ ≤ rho +
      ∑ k, (|V k p| * ‖U k - roundedU k‖ +
        |V k p - roundedV k p| * ‖roundedU k‖) := by
  calc
    _ = ‖(full - factor U V p) + (factor U V p - factor roundedU roundedV p)‖ := by
      congr 1
      abel
    _ ≤ ‖full - factor U V p‖ + ‖factor U V p - factor roundedU roundedV p‖ :=
      norm_add_le _ _
    _ ≤ _ := add_le_add h (rounded_factor_error U roundedU V roundedV p)

/-- One admitted source-free step with numerical/operator drift, source
roundoff and arithmetic residual. A is the actual current linearized law;
roundedA may differ because its base, branch arithmetic or weights differ.
Do not set operatorError=0 merely because both programs have the same name. -/
theorem numerical_transport_error (A roundedA : E →L[ℝ] E)
    (full approximate source roundedSource executed : E)
    (gain rho operatorError sourceError arithmeticError : ℝ)
    (hg : ‖A‖ ≤ gain) (hr : ‖full - approximate‖ ≤ rho)
    (hA : ‖A - roundedA‖ ≤ operatorError)
    (hb : ‖source - roundedSource‖ ≤ sourceError)
    (ha : ‖roundedA approximate + roundedSource - executed‖ ≤ arithmeticError) :
    ‖A full + source - executed‖ ≤ gain * rho +
      operatorError * ‖approximate‖ + sourceError + arithmeticError := by
  have hid : A full + source - executed =
      A (full - approximate) + (A - roundedA) approximate +
        (source - roundedSource) + (roundedA approximate + roundedSource - executed) := by
    simp only [map_sub, ContinuousLinearMap.sub_apply]
    abel
  rw [hid]
  have ht := norm_add_le
    (A (full - approximate) + (A - roundedA) approximate + (source - roundedSource))
    (roundedA approximate + roundedSource - executed)
  have h1 : ‖A (full - approximate)‖ ≤ gain * rho :=
    (A.le_opNorm _).trans (mul_le_mul hg hr (norm_nonneg _)
      ((norm_nonneg A).trans hg))
  have h2 : ‖(A - roundedA) approximate‖ ≤ operatorError * ‖approximate‖ :=
    ((A - roundedA).le_opNorm _).trans
      (mul_le_mul_of_nonneg_right hA (norm_nonneg _))
  exact ht.trans (add_le_add
    ((norm_add_le _ _).trans (add_le_add
      ((norm_add_le _ _).trans (add_le_add h1 h2)) hb)) ha)

/-- Approximation of the arrived third factor is a separate error leg from
approximation of historical participation. The final arithmetic readout must
also be charged. Same forward/branch admission precedes use of this theorem. -/
theorem numerical_credit_error (m roundedM : E →L[ℝ] ℝ)
    (full approximate : E) (computed rho modulationError arithmeticError : ℝ)
    (hr : ‖full - approximate‖ ≤ rho)
    (hm : ‖m - roundedM‖ ≤ modulationError)
    (ha : |roundedM approximate - computed| ≤ arithmeticError) :
    |m full - computed| ≤ ‖m‖ * rho +
      modulationError * ‖approximate‖ + arithmeticError := by
  have h1 := (capture_error_bound m full approximate).trans
    (mul_le_mul_of_nonneg_left hr (norm_nonneg m))
  have h2 : |m approximate - roundedM approximate| ≤ modulationError * ‖approximate‖ := by
    simpa only [ContinuousLinearMap.sub_apply, Real.norm_eq_abs] using
      ((m - roundedM).le_opNorm approximate).trans
        (mul_le_mul_of_nonneg_right hm (norm_nonneg _))
  exact (abs_sub_le (m full) (roundedM approximate) computed).trans
    (add_le_add ((abs_sub_le (m full) (m approximate) (roundedM approximate)).trans
      (add_le_add h1 h2)) ha)

/-- Positive capture is admitted only beyond the WHOLE numerical bill;
reusing the old compression-only threshold would be unsound. -/
theorem numerical_positive_capture (m roundedM : E →L[ℝ] ℝ)
    (full approximate : E) (computed rho modulationError arithmeticError : ℝ)
    (hr : ‖full - approximate‖ ≤ rho)
    (hm : ‖m - roundedM‖ ≤ modulationError)
    (ha : |roundedM approximate - computed| ≤ arithmeticError)
    (hmargin : ‖m‖ * rho + modulationError * ‖approximate‖ + arithmeticError < computed) :
    0 < m full :=
  positive_capture_of_error_margin _ _ _
    (numerical_credit_error m roundedM full approximate computed rho modulationError arithmeticError
      hr hm ha) hmargin

end NumericalAdmission

end CGB.CausalTagCompression
