import CGBAxioms.GenerationOptimizer
import CGBAxioms.GenerationContinualOptimizer
import CGBAxioms.LanguageLifeKernel

/-!
# Unified CGB optimizer contract

This module is a composition layer, not a new axiom and not a claim about a
trained language model.  It joins the already proved interfaces that were
previously tested separately:

* a non-separable pair relation (`κ * a * b`);
* a local finite-reservoir gain (anti-dominant in demand);
* simultaneous row and column budgets (competition with differentiation);
* a history carrier generated by two-state exchange;
* a dead-band trust modulator, so absent evidence does not move the bound.

The conserved carrier is supplied by the model/environment contract.  This is
deliberate: conservation alone does not identify hidden or cancelling flows.
The theorems below prove the mechanical admission properties of the composed
architecture; they do not prove task quality or that a Torch implementation
has entered this contract.
-/

namespace CGB.Unified

open CGB.Generation
open CGB.Continual
open CGB.GradientFilter
open CGB.LanguageLifeKernel

/-! ## The composed architecture -/

def balancedAllocation (p : ℝ) : Fin 2 → Fin 2 → ℝ :=
  fun i j => if i = j then p else 1 - p

noncomputable def uniformAllocation : Fin 2 → Fin 2 → ℝ := fun _ _ => 1 / 2

structure Architecture where
  relation : Fin 2 → Fin 2 → ℝ
  gain : ℝ → ℝ → ℝ
  allocation : ℝ → Fin 2 → Fin 2 → ℝ
  history : ℕ → ℝ
  modulation : Bool → ℝ
  carrier : ConservedCarrierPath

noncomputable def build (κ base kp km p₀ γ R ρ : ℝ) (carrier : ConservedCarrierPath) : Architecture :=
  { relation := cgbRelationCarrier κ
    gain := reservoirGain base
    allocation := balancedAllocation
    history := twoStateIter kp km p₀
    modulation := fun evidence => trustStep3 γ R ρ evidence
    carrier := carrier }

/-! ## Relation and local gain admission -/

/-- The composed relation and gain satisfy the existing CGB admission contract. -/
theorem build_is_cgb_candidate
    (κ base kp km p₀ γ R ρ : ℝ) (carrier : ConservedCarrierPath)
    (hκ : κ ≠ 0) (hbase : 0 < base) :
    CGBOptimizerCandidate
      (build κ base kp km p₀ γ R ρ carrier).relation
      (build κ base kp km p₀ γ R ρ carrier).gain := by
  dsimp [build]
  exact cgb_optimizer_admitted κ base hκ hbase

/-! ## Double budget: conservation of allocation and differentiation -/

/-- A bounded exchange fraction gives a nonnegative allocation. -/
theorem balanced_nonneg {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1) :
    Nonneg (balancedAllocation p) := by
  intro i j
  fin_cases i <;> fin_cases j <;> simp [balancedAllocation, hp0, hp1]

/-- A balanced allocation preserves every column budget. -/
theorem balanced_col_budget (p : ℝ) : ColBudget (balancedAllocation p) := by
  intro j
  fin_cases j <;> simp [balancedAllocation]

/-- A balanced allocation preserves every row budget. -/
theorem balanced_row_budget (p : ℝ) : RowBudget (balancedAllocation p) := by
  intro i
  fin_cases i <;> simp [balancedAllocation]

/-- The double-budget contract bounds the positive-feedback payoff. -/
theorem balanced_allocation_contract {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1) :
    Nonneg (balancedAllocation p) ∧
      ColBudget (balancedAllocation p) ∧
      RowBudget (balancedAllocation p) ∧
      payoff (balancedAllocation p) ≤ 2 := by
  have hn : Nonneg (balancedAllocation p) := balanced_nonneg hp0 hp1
  have hc : ColBudget (balancedAllocation p) := balanced_col_budget p
  have hr : RowBudget (balancedAllocation p) := balanced_row_budget p
  exact ⟨hn, hc, hr, payoff_le_two_of_col hn hc⟩

/-- At the doubly-budgeted maximum, the two rows own different directions. -/
theorem balanced_max_differentiates {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1)
    (hmax : payoff (balancedAllocation p) = 2) :
    (balancedAllocation p) 0 0 ≠ (balancedAllocation p) 1 0 := by
  exact doubly_budgeted_max_differentiates
    (balanced_nonneg hp0 hp1) (balanced_col_budget p) (balanced_row_budget p) hmax

/-! ## Relation-preservation audit -/

/- A budgeted allocation can still be relation-free at its symmetric point. -/
theorem uniform_allocation_is_budgeted :
    Nonneg uniformAllocation ∧ ColBudget uniformAllocation ∧ RowBudget uniformAllocation ∧
      ¬PairwiseRelationCarrier uniformAllocation := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro i j; simp [uniformAllocation]
  · intro j; norm_num [uniformAllocation]
  · intro i; norm_num [uniformAllocation]
  · intro h
    exact h (by simp [PairwiseRelationCarrier, interaction, uniformAllocation])

/- The balanced family carries interaction `4*p - 2`; it is nonzero only away from the
   symmetric point.  A production Sinkhorn layer therefore needs a separate relation
   preservation argument, not only row and column budget checks. -/
theorem balanced_allocation_interaction (p : ℝ) :
    interaction (balancedAllocation p) = 4 * p - 2 := by
  unfold interaction balancedAllocation
  norm_num
  ring

theorem balanced_allocation_has_relation {p : ℝ} (hp : p ≠ 1 / 2) :
    PairwiseRelationCarrier (balancedAllocation p) := by
  unfold PairwiseRelationCarrier
  rw [balanced_allocation_interaction]
  intro h
  apply hp
  linarith

/-! ## One shared phase: generated history and relation carrier -/

/- The signed relation coefficient is read from the same occupancy that carries history. -/
def phaseRelation (κ h : ℝ) : Fin 2 → Fin 2 → ℝ :=
  fun a b => κ * (2 * h - 1) * (a : ℝ) * (b : ℝ)

theorem phase_relation_interaction (κ h : ℝ) :
    interaction (phaseRelation κ h) = κ * (2 * h - 1) := by
  unfold interaction phaseRelation
  norm_num

theorem phase_relation_has_relation {κ h : ℝ} (hκ : κ ≠ 0) (hh : h ≠ 1 / 2) :
    PairwiseRelationCarrier (phaseRelation κ h) := by
  unfold PairwiseRelationCarrier
  rw [phase_relation_interaction]
  exact mul_ne_zero hκ (by intro hz; apply hh; linarith)

theorem phase_history_is_generated
    (κ h kp km : ℝ) (hkp : kp + km ≠ 0) (t : ℕ) :
    twoStateIter kp km h t - kp / (kp + km) =
      (1 - kp - km) ^ t * (h - kp / (kp + km)) := by
  exact two_state_geometric kp km h hkp t

theorem phase_step_stays_in_unit_interval {kp km h : ℝ}
    (hkp0 : 0 ≤ kp) (hkp1 : kp ≤ 1) (hkm0 : 0 ≤ km) (hkm1 : km ≤ 1)
    (hh0 : 0 ≤ h) (hh1 : h ≤ 1) :
    0 ≤ twoStateStep kp km h ∧ twoStateStep kp km h ≤ 1 := by
  unfold twoStateStep
  constructor
  · nlinarith [mul_nonneg (sub_nonneg.mpr hkm1) hh0,
      mul_nonneg hkp0 (sub_nonneg.mpr hh1)]
  · nlinarith [mul_nonneg (sub_nonneg.mpr hkp1) (sub_nonneg.mpr hh1),
      mul_nonneg hkm0 hh0]

theorem phase_history_stays_in_unit_interval {kp km h : ℝ}
    (hkp0 : 0 ≤ kp) (hkp1 : kp ≤ 1) (hkm0 : 0 ≤ km) (hkm1 : km ≤ 1)
    (hh0 : 0 ≤ h) (hh1 : h ≤ 1) :
    ∀ t : ℕ, 0 ≤ twoStateIter kp km h t ∧ twoStateIter kp km h t ≤ 1 := by
  intro t
  induction t with
  | zero => simpa [twoStateIter] using And.intro hh0 hh1
  | succ t ih =>
      simpa [twoStateIter] using phase_step_stays_in_unit_interval
        hkp0 hkp1 hkm0 hkm1 ih.1 ih.2

/-! ## Continuous typed transfer for one phase edge -/

structure RealConservedTransfer where
  sourceBefore : ℝ
  targetBefore : ℝ
  sourceAfter : ℝ
  targetAfter : ℝ
  amount : ℝ
  source_balance : sourceAfter + amount = sourceBefore
  target_balance : targetAfter = targetBefore + amount

theorem real_transfer_total (t : RealConservedTransfer) :
    t.sourceAfter + t.targetAfter = t.sourceBefore + t.targetBefore := by
  linarith [t.source_balance, t.target_balance]

theorem real_transfer_target_readout (t : RealConservedTransfer) :
    t.targetAfter - t.targetBefore = t.amount := by
  linarith [t.target_balance]

def phaseExchangeTransfer (kp km h : ℝ) : RealConservedTransfer :=
  let next := twoStateStep kp km h
  { sourceBefore := 1 - h
    targetBefore := h
    sourceAfter := 1 - next
    targetAfter := next
    amount := next - h
    source_balance := by dsimp [next, twoStateStep]; ring
    target_balance := by dsimp [next]; ring }

theorem phase_exchange_transfer_is_conserved (kp km h : ℝ) :
    (phaseExchangeTransfer kp km h).sourceAfter +
        (phaseExchangeTransfer kp km h).targetAfter = 1 := by
  simpa [phaseExchangeTransfer] using
    real_transfer_total (phaseExchangeTransfer kp km h)

theorem phase_exchange_transfer_reads_phase (kp km h : ℝ) :
    (phaseExchangeTransfer kp km h).targetAfter -
        (phaseExchangeTransfer kp km h).targetBefore =
      (phaseExchangeTransfer kp km h).amount := by
  exact real_transfer_target_readout (phaseExchangeTransfer kp km h)

/-! ## Fresh-outcome third factor -/

noncomputable def freshOutcomeGate (predicted realized deadband : ℝ) : Bool :=
  if deadband < |realized - predicted| then true else false

noncomputable def freshOutcomeTrust
    (γ R ρ predicted realized deadband : ℝ) : ℝ :=
  trustStep3 γ R ρ (freshOutcomeGate predicted realized deadband)

theorem fresh_outcome_measurement_unbiased (h e u ξ : ℝ) :
    (((h * e ^ 2 / 2 + ξ * e) - (h * (e - u) ^ 2 / 2 + ξ * (e - u))) +
      ((h * e ^ 2 / 2 + -ξ * e) - (h * (e - u) ^ 2 / 2 + -ξ * (e - u)))) / 2 =
      h * e ^ 2 / 2 - h * (e - u) ^ 2 / 2 := by
  exact fresh_decrease_unbiased h e u ξ

theorem fresh_outcome_trust_stays_in_band
    (γ R ρ predicted realized deadband : ℝ)
    (hγ : 1 < γ) (hR : 0 < R) (hlo : R / γ ≤ ρ) (hhi : ρ ≤ R * γ) :
    R / γ ≤ freshOutcomeTrust γ R ρ predicted realized deadband ∧
      freshOutcomeTrust γ R ρ predicted realized deadband ≤ R * γ := by
  unfold freshOutcomeTrust
  exact trust_with_deadband_stays_in_band γ R ρ
    (freshOutcomeGate predicted realized deadband) hγ hR hlo hhi

/-! ## Calibrated outcome evidence -/

/- A binary outcome is enough for the first calibrated third-factor channel:
   `y = 1` means that the fresh outcome was beneficial and `y = 0` means it
   was not.  The score is written as a maximisation score. -/
def bernoulliBrierScore (p y : ℝ) : ℝ :=
  2 * p * y - p ^ 2 - y ^ 2

def bernoulliExpectedBrier (p q : ℝ) : ℝ :=
  q * bernoulliBrierScore p 1 + (1 - q) * bernoulliBrierScore p 0

theorem bernoulli_expected_brier_gap (p q : ℝ) :
    bernoulliExpectedBrier p q =
      bernoulliExpectedBrier q q - (p - q) ^ 2 := by
  unfold bernoulliExpectedBrier bernoulliBrierScore
  ring

theorem bernoulli_expected_brier_calibrated (p q : ℝ) :
    bernoulliExpectedBrier p q ≤ bernoulliExpectedBrier q q := by
  rw [bernoulli_expected_brier_gap]
  linarith [sq_nonneg (p - q)]

def centeredBernoulliEvidence (p y baseline : ℝ) : ℝ :=
  bernoulliBrierScore p y - baseline

/-- Outcome prediction error uses the forecast made before observing `y`. -/
def bernoulliPredictionError (p y : ℝ) : ℝ := y - p

theorem bernoulli_prediction_error_expectation (p q : ℝ) :
    q * bernoulliPredictionError p 1 + (1 - q) * bernoulliPredictionError p 0 = q - p := by
  unfold bernoulliPredictionError
  ring

theorem brier_score_is_not_outcome_prediction_error :
    bernoulliBrierScore (1 / 2) 0 ≠ bernoulliPredictionError (1 / 2) 0 := by
  norm_num [bernoulliBrierScore, bernoulliPredictionError]

theorem centered_bernoulli_evidence_zero_mean (p q : ℝ) :
    q * centeredBernoulliEvidence p 1 (bernoulliExpectedBrier p q) +
      (1 - q) * centeredBernoulliEvidence p 0 (bernoulliExpectedBrier p q) = 0 := by
  unfold centeredBernoulliEvidence bernoulliExpectedBrier
  ring

theorem calibrated_evidence_penalty_is_square (p q : ℝ) :
    bernoulliExpectedBrier q q - bernoulliExpectedBrier p q = (p - q) ^ 2 := by
  unfold bernoulliExpectedBrier bernoulliBrierScore
  ring

/-! ## Eligibility-gated phase exchange -/

/- The calibrated third factor is a gate on the already generated local
   history transition.  It does not invent a second history state: `m = 0`
   holds the eligibility carrier and `m = 1` takes the full phase step. -/
def eligibilityGatedPhaseStep (kp km h m : ℝ) : ℝ :=
  h + m * (twoStateStep kp km h - h)

theorem eligibility_gated_phase_stays_in_unit_interval
    {kp km h m : ℝ}
    (hkp0 : 0 ≤ kp) (hkp1 : kp ≤ 1) (hkm0 : 0 ≤ km) (hkm1 : km ≤ 1)
    (hh0 : 0 ≤ h) (hh1 : h ≤ 1) (hm0 : 0 ≤ m) (hm1 : m ≤ 1) :
    0 ≤ eligibilityGatedPhaseStep kp km h m ∧
      eligibilityGatedPhaseStep kp km h m ≤ 1 := by
  have hs := phase_step_stays_in_unit_interval hkp0 hkp1 hkm0 hkm1 hh0 hh1
  unfold eligibilityGatedPhaseStep
  constructor <;> nlinarith [mul_nonneg hm0 (sub_nonneg.mpr hs.1),
    mul_nonneg (sub_nonneg.mpr hm1) (sub_nonneg.mpr hs.1),
    mul_nonneg hm0 (sub_nonneg.mpr (sub_nonneg.mpr hs.2)),
    mul_nonneg (sub_nonneg.mpr hm1) (sub_nonneg.mpr (sub_nonneg.mpr hs.2))]

theorem eligibility_gate_zero_holds (kp km h : ℝ) :
    eligibilityGatedPhaseStep kp km h 0 = h := by
  simp [eligibilityGatedPhaseStep]

theorem eligibility_gate_one_recovers (kp km h : ℝ) :
    eligibilityGatedPhaseStep kp km h 1 = twoStateStep kp km h := by
  simp [eligibilityGatedPhaseStep]

def eligibilityGatedSignedPhase (previous raw m : ℝ) : ℝ :=
  previous + m * (raw - previous)

theorem eligibility_gated_signed_phase_stays_bounded
    {previous raw m : ℝ}
    (hprev0 : -1 ≤ previous) (hprev1 : previous ≤ 1)
    (hraw0 : -1 ≤ raw) (hraw1 : raw ≤ 1)
    (hm0 : 0 ≤ m) (hm1 : m ≤ 1) :
    -1 ≤ eligibilityGatedSignedPhase previous raw m ∧
      eligibilityGatedSignedPhase previous raw m ≤ 1 := by
  unfold eligibilityGatedSignedPhase
  constructor <;> nlinarith [mul_nonneg hm0 (sub_nonneg.mpr hraw0),
    mul_nonneg (sub_nonneg.mpr hm1) (sub_nonneg.mpr hraw0),
    mul_nonneg hm0 (sub_nonneg.mpr (sub_nonneg.mpr hraw1)),
    mul_nonneg (sub_nonneg.mpr hm1) (sub_nonneg.mpr (sub_nonneg.mpr hraw1))]

theorem eligibility_gated_signed_phase_zero_holds (previous raw : ℝ) :
    eligibilityGatedSignedPhase previous raw 0 = previous := by
  simp [eligibilityGatedSignedPhase]

def latchEligibilityGate (c run : ℕ) (m : ℝ) : ℝ :=
  if c ≤ run then m else 0

theorem latch_phase_holds_before_release
    (c run : ℕ) (previous raw m : ℝ) (h : run < c) :
    eligibilityGatedSignedPhase previous raw (latchEligibilityGate c run m) = previous := by
  rw [latchEligibilityGate, if_neg (Nat.not_le.mpr h)]
  exact eligibility_gated_signed_phase_zero_holds previous raw

theorem latch_phase_releases_at_threshold
    (c run : ℕ) (previous raw m : ℝ) (h : c ≤ run) :
    eligibilityGatedSignedPhase previous raw (latchEligibilityGate c run m) =
      eligibilityGatedSignedPhase previous raw m := by
  simp [latchEligibilityGate, h]

def eligibilityGatedPhaseTransfer (kp km h m : ℝ) : RealConservedTransfer :=
  let next := eligibilityGatedPhaseStep kp km h m
  { sourceBefore := 1 - h
    targetBefore := h
    sourceAfter := 1 - next
    targetAfter := next
    amount := next - h
    source_balance := by dsimp [next]; ring
    target_balance := by dsimp [next]; ring }

theorem eligibility_gated_transfer_is_conserved (kp km h m : ℝ) :
    (eligibilityGatedPhaseTransfer kp km h m).sourceAfter +
        (eligibilityGatedPhaseTransfer kp km h m).targetAfter = 1 := by
  simpa [eligibilityGatedPhaseTransfer] using
    real_transfer_total (eligibilityGatedPhaseTransfer kp km h m)

theorem eligibility_gated_transfer_reads_phase (kp km h m : ℝ) :
    (eligibilityGatedPhaseTransfer kp km h m).targetAfter -
        (eligibilityGatedPhaseTransfer kp km h m).targetBefore =
      (eligibilityGatedPhaseTransfer kp km h m).amount := by
  exact real_transfer_target_readout (eligibilityGatedPhaseTransfer kp km h m)

/-! ## A minimal EMA history-collision witness -/

def emaStep (β x y : ℝ) : ℝ := β * x + (1 - β) * y

def ema3 (β g₀ g₁ g₂ : ℝ) : ℝ :=
  emaStep β (emaStep β (emaStep β 0 g₀) g₁) g₂

def emaSquare3 (β g₀ g₁ g₂ : ℝ) : ℝ :=
  ema3 β (g₀ ^ 2) (g₁ ^ 2) (g₂ ^ 2)

/- Distinct ordered histories can have identical first and second EMA states. -/
theorem ema_history_collision :
    (0 : ℝ) ≠ 2 ∧
      ema3 (1 / 2) 2 0 0 = ema3 (1 / 2) (-2 / 3) (4 / 3) 0 ∧
      emaSquare3 (1 / 2) 2 0 0 = emaSquare3 (1 / 2) (-2 / 3) (4 / 3) 0 := by
  refine ⟨by norm_num, ?_, ?_⟩ <;> norm_num [ema3, emaSquare3, emaStep] <;> ring

/-- The built architecture exposes both row and column competition budgets. -/
theorem build_has_competition_and_differentiation
    (κ base kp km p₀ γ R ρ : ℝ) (carrier : ConservedCarrierPath)
    {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1) :
    Nonneg ((build κ base kp km p₀ γ R ρ carrier).allocation p) ∧
      ColBudget ((build κ base kp km p₀ γ R ρ carrier).allocation p) ∧
      RowBudget ((build κ base kp km p₀ γ R ρ carrier).allocation p) := by
  dsimp [build]
  exact ⟨balanced_nonneg hp0 hp1, balanced_col_budget p, balanced_row_budget p⟩

/-! ## Generated history rather than a separately postulated eligibility module -/

/-- The retained history is the geometric trace generated by two-state exchange. -/
theorem build_history_is_geometric
    (κ base kp km p₀ γ R ρ : ℝ) (carrier : ConservedCarrierPath)
    (h : kp + km ≠ 0) (t : ℕ) :
    (build κ base kp km p₀ γ R ρ carrier).history t - kp / (kp + km) =
      (1 - kp - km) ^ t * (p₀ - kp / (kp + km)) := by
  simpa [build] using two_state_geometric kp km p₀ h t

/-- The supplied typed carrier exposes its telescoping conserved history. -/
theorem build_history_balance
    (κ base kp km p₀ γ R ρ : ℝ) (carrier : ConservedCarrierPath) (k : ℕ) :
    (build κ base kp km p₀ γ R ρ carrier).carrier.value k -
        (build κ base kp km p₀ γ R ρ carrier).carrier.value 0 =
      Finset.sum (Finset.range k)
        (fun n => (build κ base kp km p₀ γ R ρ carrier).carrier.input n -
          (build κ base kp km p₀ γ R ρ carrier).carrier.output n) := by
  exact conserved_carrier_path_balance carrier k

/-! ## Local modulation and release -/

/-- The outcome gate leaves a dead band and stays inside the trust interval. -/
theorem build_modulation_stays_in_band
    (κ base kp km p₀ γ R ρ : ℝ) (carrier : ConservedCarrierPath)
    (hγ : 1 < γ) (hR : 0 < R) (hlo : R / γ ≤ ρ) (hhi : ρ ≤ R * γ)
    (evidence : Bool) :
    R / γ ≤ (build κ base kp km p₀ γ R ρ carrier).modulation evidence ∧
      (build κ base kp km p₀ γ R ρ carrier).modulation evidence ≤ R * γ := by
  simpa [build] using trust_with_deadband_stays_in_band γ R ρ evidence hγ hR hlo hhi

/-- The latch both holds under short contrary evidence and releases at its threshold. -/
theorem build_latch_holds_and_releases
    (c runHold runRelease : ℕ) (v d : ℝ)
    (hhold : runHold < c) (hrelease : c ≤ runRelease) :
    deferLatch c runHold v d = v ∧ deferLatch c runRelease v d = d := by
  constructor
  · exact deferLatch_holds c runHold v d hhold
  · exact deferLatch_releases c runRelease v d hrelease

/-! ## One theorem for the mechanical admission contract -/

/-- Combined mechanical admission: relation, competition, history and modulation. -/
theorem build_mechanical_admission
    (κ base kp km p₀ γ R ρ : ℝ) (carrier : ConservedCarrierPath)
    (hκ : κ ≠ 0) (hbase : 0 < base)
    {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1)
    (hγ : 1 < γ) (hR : 0 < R) (hlo : R / γ ≤ ρ) (hhi : ρ ≤ R * γ)
    (h : kp + km ≠ 0) (t : ℕ) :
    CGBOptimizerCandidate
        (build κ base kp km p₀ γ R ρ carrier).relation
        (build κ base kp km p₀ γ R ρ carrier).gain ∧
      Nonneg ((build κ base kp km p₀ γ R ρ carrier).allocation p) ∧
      ColBudget ((build κ base kp km p₀ γ R ρ carrier).allocation p) ∧
      RowBudget ((build κ base kp km p₀ γ R ρ carrier).allocation p) ∧
      ((build κ base kp km p₀ γ R ρ carrier).history t - kp / (kp + km) =
        (1 - kp - km) ^ t * (p₀ - kp / (kp + km))) ∧
      (R / γ ≤ (build κ base kp km p₀ γ R ρ carrier).modulation false ∧
        (build κ base kp km p₀ γ R ρ carrier).modulation false ≤ R * γ) := by
  refine ⟨build_is_cgb_candidate κ base kp km p₀ γ R ρ carrier hκ hbase, ?_, ?_, ?_, ?_, ?_⟩
  · exact balanced_nonneg hp0 hp1
  · exact balanced_col_budget p
  · exact balanced_row_budget p
  · exact build_history_is_geometric κ base kp km p₀ γ R ρ carrier h t
  · exact (build_modulation_stays_in_band κ base kp km p₀ γ R ρ carrier
      hγ hR hlo hhi false)

end CGB.Unified
