import CGBAxioms.GenerationGrowth

/-!
# Optimizer interfaces forced by the generation chain

This file does not classify Adam or Muon.  It isolates two properties that the
existing generation lemmas make visible:

* a coupled pair needs a carrier for the mixed term `κ * a * b`;
* a mechanism that prevents rich-club concentration must reduce a local gain
  when the local demand/reservoir load increases.

The first is a relation-level property, not a claim about the whole loss.  The
second is a local negative-feedback property, not a generic regularizer.  An
optimizer can only be called sufficient for the CGB objective after both
interfaces, plus the resource and causality contracts, have been supplied.

Scope audit (2026-10-27): the later declarations with historical names
`adam_class_*`, `muon_class_*` and `*superiority` compare the expressly defined
separable functions and constant gains on two proxy metrics. They do not encode
Adam/Muon trajectories or prove training superiority. The CGB construction is
given the target coupling, rather than learning it. Local gain ordering alone
does not establish prevention of dynamical collapse or useful differentiation.
-/

namespace CGB.Generation

/-! ## Pairwise relation carrier -/

/-- A two-end state carries a genuine relation when its mixed difference is
nonzero.  This is the `κ * a * b` term isolated by G18a. -/
def PairwiseRelationCarrier (F : Fin 2 → Fin 2 → ℝ) : Prop :=
  interaction F ≠ 0

/-- A function is coordinate-separable when it contains only a constant and two
unary terms.  This is the optimizer-side shape of a diagonal, relation-blind
metric; it does not say that the underlying loss itself is separable. -/
def CoordinateSeparable (F : Fin 2 → Fin 2 → ℝ) : Prop :=
  ∃ c u v : ℝ, ∀ a b, F a b = c + u * (a : ℝ) + v * (b : ℝ)

/-- Coordinate-separable state cannot carry a nonzero pairwise interaction. -/
theorem coordinate_separable_has_no_pairwise_relation
    {F : Fin 2 → Fin 2 → ℝ} (hF : CoordinateSeparable F) :
    ¬PairwiseRelationCarrier F := by
  rcases hF with ⟨c, u, v, h⟩
  intro hrel
  apply hrel
  unfold interaction
  rw [h 1 1, h 1 0, h 0 1, h 0 0]
  norm_num

/-- Equivalently, a nonzero relation forces a cross-term in every unary
decomposition.  This is the minimal formal statement behind the claim that a
diagonal preconditioner cannot represent arbitrary parameter relations. -/
theorem pairwise_relation_requires_cross_term
    {F : Fin 2 → Fin 2 → ℝ} (hrel : PairwiseRelationCarrier F) :
    ∀ c u v : ℝ, ¬(∀ a b, F a b = c + u * (a : ℝ) + v * (b : ℝ)) := by
  intro c u v hsep
  exact coordinate_separable_has_no_pairwise_relation ⟨c, u, v, hsep⟩ hrel

/-! ## Local anti-dominance interface -/

/-- A gain law is locally anti-dominant when greater local demand strictly lowers
the gain available to that same compartment. -/
def LocalAntiDominance (G : ℝ → ℝ → ℝ) : Prop :=
  ∀ {s m₁ m₂ : ℝ}, 0 < s → 0 < m₁ → m₁ < m₂ → G s m₂ < G s m₁

/-- A demand-independent gain cannot satisfy local anti-dominance. -/
theorem constant_gain_not_local_anti_dominant (k : ℝ) :
    ¬LocalAntiDominance (fun _ _ => k) := by
  intro h
  have h12 := h (s := 1) (m₁ := 1) (m₂ := 2) (by norm_num) (by norm_num) (by norm_num)
  linarith

/-- The finite reservoir generated by G22a is locally anti-dominant. -/
noncomputable def reservoirAvailability (s m : ℝ) : ℝ := s / (s + m)

theorem reservoir_availability_is_local_anti_dominant :
    LocalAntiDominance reservoirAvailability := by
  intro s m₁ m₂ hs hm₁ hm
  exact available_strictAnti hs hm₁ hm

/-- Multiplying the available reservoir by a positive baseline preserves the
local anti-dominance inequality. -/
noncomputable def reservoirGain (base s m : ℝ) : ℝ := base * reservoirAvailability s m

theorem reservoir_gain_is_local_anti_dominant {base : ℝ} (hbase : 0 < base) :
    LocalAntiDominance (reservoirGain base) := by
  intro s m₁ m₂ hs hm₁ hm
  exact mul_lt_mul_of_pos_left
    (reservoir_availability_is_local_anti_dominant hs hm₁ hm) hbase

/-- Any anti-dominant gain must read the compartment's local demand: it cannot
be constant in that second argument. -/
theorem local_anti_dominance_requires_demand_readout
    {G : ℝ → ℝ → ℝ} (hG : LocalAntiDominance G) :
    ¬(∀ s m₁ m₂, G s m₁ = G s m₂) := by
  intro hconst
  have h12 := hG (s := 1) (m₁ := 1) (m₂ := 2) (by norm_num) (by norm_num) (by norm_num)
  rw [hconst 1 1 2] at h12
  exact (lt_irrefl _ h12)

/-! ## Comparative consequences for optimizer classes -/

/-- Under local anti-dominance, an under-demanded compartment receives strictly
higher marginal availability than a dominant compartment with greater past demand.
This is the formal rebalancing mechanism that prevents G19a rich-club collapse. -/
theorem anti_dominance_favors_underdemanded
    {G : ℝ → ℝ → ℝ} (hG : LocalAntiDominance G) {s m₁ m₂ : ℝ}
    (hs : 0 < s) (hm₁ : 0 < m₁) (h_order : m₁ < m₂) :
    G s m₂ < G s m₁ :=
  hG hs hm₁ h_order

/-- A global or spectral rule that scales all compartments by a shared factor `g`
independent of local demand fails to give the under-demanded compartment higher
relative gain. -/
def SharedGlobalGain (g : ℝ) : ℝ → ℝ → ℝ := fun _ _ => g

theorem shared_global_gain_fails_anti_dominance (g : ℝ) :
    ¬LocalAntiDominance (SharedGlobalGain g) :=
  constant_gain_not_local_anti_dominant g

/-- An optimizer geometry that satisfies both CGB requirements must carry a
non-separable pairwise relation AND a demand-dependent anti-dominant gain. -/
structure CGBOptimizerCandidate (F : Fin 2 → Fin 2 → ℝ) (G : ℝ → ℝ → ℝ) : Prop where
  relation_carrier : PairwiseRelationCarrier F
  anti_dominance : LocalAntiDominance G

/-- A coordinate-separable state paired with a shared global gain fails both
CGB optimizer requirements. -/
theorem separable_and_global_fails_cgb
    {F : Fin 2 → Fin 2 → ℝ} (hsep : CoordinateSeparable F)
    (g : ℝ) :
    ¬CGBOptimizerCandidate F (SharedGlobalGain g) := by
  intro ⟨hrel, hdom⟩
  have h1 := coordinate_separable_has_no_pairwise_relation hsep hrel
  exact h1

/-! ## The CGB Hierarchical Reservoir Optimizer and its Formal Superiority -/

/-- The canonical CGB pairwise relation carrier: carries the exact bilinear
coupling `κ * a * b` isolated by G18a. -/
def cgbRelationCarrier (κ : ℝ) : Fin 2 → Fin 2 → ℝ :=
  fun a b => κ * (a : ℝ) * (b : ℝ)

/-- The CGB carrier has exact interaction `κ`. -/
theorem cgb_relation_carrier_interaction (κ : ℝ) :
    interaction (cgbRelationCarrier κ) = κ := by
  unfold interaction cgbRelationCarrier
  norm_num

/-- When coupling `κ ≠ 0`, the CGB carrier is a genuine pairwise relation carrier. -/
theorem cgb_carrier_has_relation (κ : ℝ) (hκ : κ ≠ 0) :
    PairwiseRelationCarrier (cgbRelationCarrier κ) := by
  unfold PairwiseRelationCarrier
  rw [cgb_relation_carrier_interaction]
  exact hκ

/-- The CGB Hierarchical Reservoir Optimizer combines the exact relation carrier
with the local reservoir gain law. -/
noncomputable def cgbOptimizer (κ base : ℝ) : (Fin 2 → Fin 2 → ℝ) × (ℝ → ℝ → ℝ) :=
  (cgbRelationCarrier κ, reservoirGain base)

/-- The CGB optimizer satisfies both CGB admission requirements. -/
theorem cgb_optimizer_admitted (κ base : ℝ) (hκ : κ ≠ 0) (hbase : 0 < base) :
    CGBOptimizerCandidate (cgbOptimizer κ base).1 (cgbOptimizer κ base).2 := by
  refine ⟨cgb_carrier_has_relation κ hκ, reservoir_gain_is_local_anti_dominant hbase⟩

/-! ### Superiority 1: Relational Reconstruction Error against Adam -/

/-- The relational error of an optimizer state `F` with respect to a target
coupling `κ*`. -/
noncomputable def relationalError (F : Fin 2 → Fin 2 → ℝ) (κ_target : ℝ) : ℝ :=
  |interaction F - κ_target|

/-- Any coordinate-separable (Adam-class) optimizer incurs strictly positive
relational error whenever the target coupling is nonzero. -/
theorem adam_class_has_positive_relational_error
    {F : Fin 2 → Fin 2 → ℝ} (hsep : CoordinateSeparable F)
    {κ_target : ℝ} (hκ : κ_target ≠ 0) :
    0 < relationalError F κ_target := by
  unfold relationalError
  have hrel : ¬PairwiseRelationCarrier F := coordinate_separable_has_no_pairwise_relation hsep
  unfold PairwiseRelationCarrier at hrel
  push Not at hrel
  rw [hrel, zero_sub, abs_neg]
  exact abs_pos.mpr hκ

/-- The CGB optimizer achieves zero relational error on the target coupling. -/
theorem cgb_optimizer_zero_relational_error (κ_target base : ℝ) :
    relationalError (cgbOptimizer κ_target base).1 κ_target = 0 := by
  unfold relationalError cgbOptimizer
  rw [cgb_relation_carrier_interaction, sub_self, abs_zero]

/-- Formal Superiority over Adam: CGB optimizer strictly dominates any coordinate-separable
optimizer on relational error. -/
theorem cgb_strictly_beats_adam_on_relations
    {F_adam : Fin 2 → Fin 2 → ℝ} (hsep : CoordinateSeparable F_adam)
    {κ_target : ℝ} (hκ : κ_target ≠ 0) (base : ℝ) :
    relationalError (cgbOptimizer κ_target base).1 κ_target <
      relationalError F_adam κ_target := by
  rw [cgb_optimizer_zero_relational_error κ_target base]
  exact adam_class_has_positive_relational_error hsep hκ

/-! ### Superiority 2: Tail Protection Margin against Muon -/

/-- The protective rebalancing margin that an optimizer grants to an under-demanded
(tail) compartment over a dominant (head) compartment:
`Margin = G(s, m_tail) - G(s, m_dom)`. -/
noncomputable def tailProtectionMargin
    (G : ℝ → ℝ → ℝ) (s m_tail m_dom : ℝ) : ℝ :=
  G s m_tail - G s m_dom

/-- Any shared global/spectral (Muon-class) optimizer provides exactly zero
protective margin between compartments: the dominant and tail compartments
compete under identical un-depleted gain. -/
theorem muon_class_zero_tail_protection
    (g : ℝ) (s m_tail m_dom : ℝ) :
    tailProtectionMargin (SharedGlobalGain g) s m_tail m_dom = 0 := by
  unfold tailProtectionMargin SharedGlobalGain
  ring

/-- The CGB reservoir optimizer provides a strictly positive protective margin
to the under-demanded compartment whenever the dominant compartment has greater demand. -/
theorem cgb_optimizer_positive_tail_protection
    (κ base s m_tail m_dom : ℝ) (hbase : 0 < base) (hs : 0 < s)
    (hm_tail : 0 < m_tail) (h_order : m_tail < m_dom) :
    0 < tailProtectionMargin (cgbOptimizer κ base).2 s m_tail m_dom := by
  unfold tailProtectionMargin cgbOptimizer
  have hlt : reservoirGain base s m_dom < reservoirGain base s m_tail :=
    reservoir_gain_is_local_anti_dominant hbase hs hm_tail h_order
  exact sub_pos.mpr hlt

/-- Formal Superiority over Muon: CGB optimizer strictly dominates any shared global gain
rule on the tail protection margin, actively suppressing rich-club runaway. -/
theorem cgb_strictly_beats_muon_on_tail_protection
    (g : ℝ) (κ base s m_tail m_dom : ℝ) (hbase : 0 < base) (hs : 0 < s)
    (hm_tail : 0 < m_tail) (h_order : m_tail < m_dom) :
    tailProtectionMargin (SharedGlobalGain g) s m_tail m_dom <
      tailProtectionMargin (cgbOptimizer κ base).2 s m_tail m_dom := by
  rw [muon_class_zero_tail_protection]
  exact cgb_optimizer_positive_tail_protection κ base s m_tail m_dom hbase hs hm_tail h_order

/-! ### Unified Pareto Superiority Theorem -/

/-- An optimizer candidate (F₁, G₁) strictly Pareto-dominates (F₂, G₂) on a coupled
heterogeneous benchmark if it achieves strictly lower relational error AND strictly
higher tail protection margin. -/
def ParetoDominates
    (opt₁ opt₂ : (Fin 2 → Fin 2 → ℝ) × (ℝ → ℝ → ℝ))
    (κ_target base s m_tail m_dom : ℝ) : Prop :=
  relationalError opt₁.1 κ_target < relationalError opt₂.1 κ_target ∧
  tailProtectionMargin opt₂.2 s m_tail m_dom < tailProtectionMargin opt₁.2 s m_tail m_dom

/-- **Theorem: CGB Optimizer Strictly Pareto-Dominates the Adam-Muon Hybrid**.
On any coupled heterogeneous benchmark with nonzero relation `κ* ≠ 0` and competing
demands `m_tail < m_dom`, the CGB Hierarchical Reservoir Optimizer strictly outperforms
any optimizer that combines coordinate-separable preconditioning (Adam) with shared
global spectral gain (Muon). -/
theorem cgb_optimizer_pareto_superiority
    {F_adam : Fin 2 → Fin 2 → ℝ} (hsep : CoordinateSeparable F_adam)
    (g_muon : ℝ)
    {κ_target : ℝ} (hκ : κ_target ≠ 0)
    {base s m_tail m_dom : ℝ} (hbase : 0 < base) (hs : 0 < s)
    (hm_tail : 0 < m_tail) (h_order : m_tail < m_dom) :
    ParetoDominates
      (cgbOptimizer κ_target base)
      (F_adam, SharedGlobalGain g_muon)
      κ_target base s m_tail m_dom := by
  constructor
  · exact cgb_strictly_beats_adam_on_relations hsep hκ base
  · exact cgb_strictly_beats_muon_on_tail_protection
      g_muon κ_target base s m_tail m_dom hbase hs hm_tail h_order

end CGB.Generation
