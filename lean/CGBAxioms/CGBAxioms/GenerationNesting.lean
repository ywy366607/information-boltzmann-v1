import CGBAxioms.GenerationAmplifier
import CGBAxioms.Nesting

/-!
# Nesting: the world is a medium too (generation chain, G26)

An organism is a medium; the world it lives in obeys the same axioms, and so does a body that
hosts organisms (mitochondria, gut bacteria) or a collective made of bodies. Within the rule-table
family nesting is closed by construction: putting an organism's pages and a world's pages into
one table, the organism's former boundary pages become interior pages of the joint medium, and
`tableCRN.axioms` admits the joint table exactly when every rule between interior pages (the
couplings included) conserves content. What was reservoir work at the organism's boundary
becomes an actual transfer of content to or from the world.

Two consequences used by the chemotaxis world:

* `cell_potential` (G26a): a world cell holding food at occupancy `q` is balanced with a
  reservoir of potential `μ` exactly when `μ = log (q / (1 - q))`; for dilute food this is
  `log q`, the `ln c` the receptors read. The sensory interface follows from the world being a
  medium (G18 occupancy).
* `stay_starves` (G26b): food is conserved, so a site regenerated by at most `r` per tick gives
  an organism that stays there at most `f₀ + r T` in `T` ticks. If living costs `c > r` per tick,
  the reserve falls below zero in finite time: staying put is death, the organism must move.
  `site_balance` holds for any set of sites (take `f` the set's total): the organism's intake is
  bounded by what flows into the part of the world it touches (T-N6).
* `cell_step` (T-N4): a world cell's potential comes from its configuration entropy; exchanging
  with a large cell is exchanging with a reservoir at `≈ ln c`.
* `stream_never_dry` (T-N7): the infinite information stream is temporal. Any stationary
  world–organism process with one state whose next boundary reading is not determined defeats
  every predictor of the next reading at every tick, however small the world is.

General nesting (one medium, boundary induced by contact, both blanket halves, exchange
conservation, frozen-world balance) is in `Nesting.lean` (T-N1–T-N3).
-/

namespace CGB.Generation

/-- **G26a (the sensed potential of a world cell)**. -/
theorem cell_potential (μ : ℝ) : occupancy μ / (1 - occupancy μ) = Real.exp μ ∧
    Real.log (occupancy μ / (1 - occupancy μ)) = μ :=
  ⟨occupancy_odds μ, by rw [occupancy_odds, Real.log_exp]⟩

/-- Conservation at a site: food after `T` ticks plus everything eaten is at most the initial
food plus the regeneration. -/
theorem site_balance (f e g : ℕ → ℝ) (r : ℝ) (hf : ∀ t, f (t + 1) = f t - e t + g t)
    (hg : ∀ t, g t ≤ r) (T : ℕ) :
    f T + ∑ t ∈ Finset.range T, e t ≤ f 0 + r * T := by
  induction T with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_range_succ, hf n]
    push_cast
    linarith [hg n]

/-- **G26b (staying put starves)**: with food never negative, regeneration at most `r`,
and a reserve that gains at most what is eaten and pays `c` per tick, the reserve after `T`
ticks is at most `R₀ + f₀ + (r - c) T`. -/
theorem stay_starves (f e g R : ℕ → ℝ) (r c : ℝ) (hf : ∀ t, f (t + 1) = f t - e t + g t)
    (hg : ∀ t, g t ≤ r) (hpos : ∀ t, 0 ≤ f t) (hR : ∀ t, R (t + 1) ≤ R t + e t - c) (T : ℕ) :
    R T ≤ R 0 + f 0 + (r - c) * T := by
  have hsum : ∀ n, R n ≤ R 0 + ∑ t ∈ Finset.range n, e t - c * n := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Finset.sum_range_succ]
      push_cast
      linarith [hR n]
  have := site_balance f e g r hf hg T
  have h0 := hpos T
  linarith [hsum T]

/-- The reserve is exhausted in finite time when living costs more than the site regenerates. -/
theorem stay_dies (f e g R : ℕ → ℝ) (r c : ℝ) (hf : ∀ t, f (t + 1) = f t - e t + g t)
    (hg : ∀ t, g t ≤ r) (hpos : ∀ t, 0 ≤ f t) (hR : ∀ t, R (t + 1) ≤ R t + e t - c)
    (hc : r < c) : ∃ T : ℕ, R T < 0 := by
  obtain ⟨T, hT⟩ := exists_nat_gt ((R 0 + f 0) / (c - r))
  refine ⟨T, lt_of_le_of_lt (stay_starves f e g R r c hf hg hpos hR T) ?_⟩
  have hcr : 0 < c - r := by linarith
  rw [div_lt_iff₀ hcr] at hT
  nlinarith

/-- **T-N4 (a world cell is a reservoir)**: free energy of a world cell of `V` sites holding `n` identical quanta (configuration
entropy only). -/
noncomputable def cellF (V n : ℕ) : ℝ := -Real.log (Nat.choose V n)

/-- Adding one quantum to a cell holding `n` of `V` costs exactly `log ((n + 1) / (V - n))`, so to a
unit exchanging quanta with it the cell is a reservoir of potential `≈ log (n / V) = ln c`, and one
exchange moves that potential only by `≈ 1/n`: the `PairCRN` reservoir and the receptors' `ln c`
are the limit of exchanging with a large world cell (with G26a). -/
theorem cell_step (V n : ℕ) (hn : n < V) :
    cellF V (n + 1) - cellF V n = Real.log ((n + 1) / (V - n)) := by
  unfold cellF
  have h1 : (0 : ℝ) < Nat.choose V n := by exact_mod_cast Nat.choose_pos hn.le
  have h2 : (0 : ℝ) < Nat.choose V (n + 1) := by exact_mod_cast Nat.choose_pos hn
  have hk : (Nat.choose V (n + 1) : ℝ) * (n + 1) = Nat.choose V n * (V - n) := by
    have := Nat.choose_succ_right_eq V n
    have hc : ((V - n : ℕ) : ℝ) = (V : ℝ) - n := by
      rw [Nat.cast_sub hn.le]
    rw [← hc]; exact_mod_cast this
  have hVn : (0 : ℝ) < (V : ℝ) - n := by
    have : (n : ℝ) < V := by exact_mod_cast hn
    linarith
  have hn1 : (0 : ℝ) < (n : ℝ) + 1 := by positivity
  rw [Real.log_div hn1.ne' hVn.ne']
  have : Real.log (Nat.choose V (n + 1)) + Real.log ((n : ℝ) + 1) =
      Real.log (Nat.choose V n) + Real.log ((V : ℝ) - n) := by
    rw [← Real.log_mul h2.ne' hn1.ne', ← Real.log_mul h1.ne' hVn.ne', hk]
  linarith


variable {W R : Type*} [Fintype W] [DecidableEq R]

/-- One-step error of predicting the next reading `r` by `g` of the current state, from `w`. -/
noncomputable def missProb (K : W → W → ℝ) (r : W → R) (g : W → R) (w : W) : ℝ :=
  ∑ w', if r w' = g w then 0 else K w w'

theorem missProb_ge (K : W → W → ℝ) (hK : ∀ w w', 0 ≤ K w w') (r : W → R) (g : W → R) (x : W)
    {y₁ y₂ : W} (hr : r y₁ ≠ r y₂) :
    min (K x y₁) (K x y₂) ≤ missProb K r g x := by
  unfold missProb
  have hnn : ∀ w', 0 ≤ (if r w' = g x then 0 else K x w') := fun w' => by
    split_ifs <;> simp [hK]
  by_cases h1 : r y₁ = g x
  · have h2 : r y₂ ≠ g x := fun h => hr (h1.trans h.symm)
    calc min (K x y₁) (K x y₂) ≤ K x y₂ := min_le_right _ _
      _ = (if r y₂ = g x then 0 else K x y₂) := by simp [h2]
      _ ≤ ∑ w', (if r w' = g x then 0 else K x w') :=
          Finset.single_le_sum (fun w' _ => hnn w') (Finset.mem_univ y₂)
  · calc min (K x y₁) (K x y₂) ≤ K x y₁ := min_le_left _ _
      _ = (if r y₁ = g x then 0 else K x y₁) := by simp [h1]
      _ ≤ ∑ w', (if r w' = g x then 0 else K x w') :=
          Finset.single_le_sum (fun w' _ => hnn w') (Finset.mem_univ y₁)

/-- **T-N7 (the stream never runs dry)**: under a stationary law `π` of the world–organism
process, if some state `x` (weight `π x`) has two possible successors with different boundary
readings, then every predictor of the next reading from the full current state errs with
probability at least `π x · min (K x y₁) (K x y₂) > 0` at every tick, so its expected number of
errors over `T` ticks grows at least linearly in `T`. -/
theorem stream_never_dry (K : W → W → ℝ) (hK : ∀ w w', 0 ≤ K w w') (π : W → ℝ)
    (hπ : ∀ w, 0 ≤ π w) (r : W → R) (g : W → R) (x : W) {y₁ y₂ : W}
    (hr : r y₁ ≠ r y₂) (T : ℕ) :
    (T : ℝ) * (π x * min (K x y₁) (K x y₂)) ≤
      ∑ _t ∈ Finset.range T, ∑ w, π w * missProb K r g w := by
  have hmiss : ∀ w, 0 ≤ missProb K r g w := fun w =>
    Finset.sum_nonneg fun w' _ => by split_ifs <;> simp [hK]
  have hone : π x * min (K x y₁) (K x y₂) ≤ ∑ w, π w * missProb K r g w :=
    calc π x * min (K x y₁) (K x y₂) ≤ π x * missProb K r g x :=
          mul_le_mul_of_nonneg_left (missProb_ge K hK r g x hr) (hπ x)
      _ ≤ ∑ w, π w * missProb K r g w :=
          Finset.single_le_sum (fun w _ => mul_nonneg (hπ w) (hmiss w)) (Finset.mem_univ x)
  rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  exact mul_le_mul_of_nonneg_left hone (Nat.cast_nonneg T)

end CGB.Generation
